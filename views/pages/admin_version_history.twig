{% set entries = model.entries|default([]) %}
<div class="admin-overview admin-history">
    <header class="admin-dash-heading">
        <div>
            <h1>Version history</h1>
            <p class="admin-history-count">{{ entries|length|number_format }} {{ entries|length == 1 ? 'entry' : 'entries' }} · VERSION_HISTORY.md</p>
        </div>
        <a href="{{ url('/admin/') }}">Dashboard</a>
    </header>
    {% if entries %}
        <div class="admin-history-list">
            {% for entry in entries %}
                <details class="admin-history-entry"{% if loop.first %} open{% endif %}>
                    <summary>
                        <strong>{{ entry.version }}</strong>
                        {% if entry.type %}<span class="admin-history-type">{{ entry.type }}</span>{% endif %}
                        {% if entry.date %}<span class="admin-history-date">{{ entry.date }}</span>{% endif %}
                    </summary>
                    <div class="admin-history-notes">
                        {% if entry.base %}<p class="admin-history-base">Updates from <b>{{ entry.base }}</b></p>{% endif %}
                        {% if entry.markdown|trim %}
                            {% include 'partials/formatted_content.twig' with {content: {type: 'release_notes', body: entry.markdown}} only %}
                        {% else %}<p>No release notes recorded.</p>{% endif %}
                    </div>
                </details>
            {% endfor %}
        </div>
    {% else %}
        <p>No version history entries have been recorded.</p>
    {% endif %}
</div>
