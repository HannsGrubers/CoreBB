{% if model.error|default('') %}
<table class="wb-cellpad-15 wb-cellspace-0 wb-table" style="width: 100%;">
    <tr><td class="BoardRowB">
        {{ model.error }}
        {% if model.errorLink|default(null) %}
            <p><a class="BoardRowBLink" href="{{ model.errorLink.href }}">{{ model.errorLink.text }}</a></p>
        {% endif %}
    </td></tr>
</table>
{% else %}

<script src="{{ asset('scripts/posttoolbar_support.js') }}" id="posttoolbar_support"></script>
<script src="{{ asset('scripts/posttoolbar.js') }}" id="posttoolbar_main"></script>
<script>
var submitted = false;
function SubmitTheForm(form){
    if(submitted == true){ return false; }
    submitted = true;

    var btn = form && form.elements ? form.elements['submitButton'] : null;
    if(btn){
        btn.value = 'Please wait...';
        // Do not disable the submit button synchronously. Some browsers will
        // cancel the native submit if the clicked submit control is disabled
        // during its own click event. Disable it just after submission starts.
        window.setTimeout(function(){ btn.disabled = true; }, 50);
    }
    return true;
}

function wbPostImageSetStatus(message, isError){
    var status = document.getElementById('post_image_upload_status');
    if(!status){ return; }
    status.innerHTML = message || '';
    status.style.fontWeight = isError ? 'bold' : 'normal';
}

function wbPostImageInsertText(text){
    if(!text){ return false; }
    if(typeof pst_fnInsertCode === 'function'){
        return pst_fnInsertCode(text);
    }

    var box = document.getElementById('message_body');
    if(!box){ return false; }
    box.focus();

    var value = box.value || '';
    var start = typeof box.selectionStart !== 'undefined' ? box.selectionStart : value.length;
    var end = typeof box.selectionEnd !== 'undefined' ? box.selectionEnd : start;
    box.value = value.substring(0, start) + text + value.substring(end);
    var nextPos = start + text.length;
    if(box.setSelectionRange){
        box.setSelectionRange(nextPos, nextPos);
    }
    box.focus();
    return true;
}

function wbPostImageResetInsertedFlag(){
    var flag = document.getElementById('post_image_upload_already_inserted');
    if(flag){ flag.value = '0'; }
    wbPostImageSetStatus('', false);
}

function wbPostImageUploadAndInsert(){
    var form = document.getElementById('frmMain');
    var file = document.getElementById('post_image_upload');
    var button = document.getElementById('post_image_upload_button');
    var endpoint = document.getElementById('post_image_upload_endpoint');
    var flag = document.getElementById('post_image_upload_already_inserted');

    if(!form || !file || !file.files || file.files.length < 1){
        wbPostImageSetStatus('Choose an image first.', true);
        return false;
    }
    if(!window.FormData || !window.XMLHttpRequest){
        wbPostImageSetStatus('Your browser cannot insert before posting. The image will be attached when you post.', true);
        return false;
    }

    var data = new FormData();
    data.append('post_image_upload', file.files[0]);

    var token = form.querySelector('input[name="corebb_csrf_token"], input[name="wb_csrf_token"]');
    if(token){
        data.append('corebb_csrf_token', token.value);
    }

    if(button){
        button.disabled = true;
        button.value = 'Uploading...';
    }
    wbPostImageSetStatus('Uploading image...', false);

    var xhr = new XMLHttpRequest();
    xhr.open('POST', endpoint ? endpoint.value : '/post/image-upload/', true);
    xhr.onreadystatechange = function(){
        if(xhr.readyState !== 4){ return; }

        if(button){
            button.disabled = false;
            button.value = 'Upload + Insert Tag';
        }

        var payload = null;
        try {
            payload = JSON.parse(xhr.responseText || '{}');
        } catch(e) {
            payload = null;
        }

        if(xhr.status >= 200 && xhr.status < 300 && payload && payload.ok && payload.bbcode){
            wbPostImageInsertText(payload.bbcode);
            if(flag){ flag.value = '1'; }
            try { file.value = ''; } catch(clearErr) {}
            wbPostImageSetStatus('Inserted ' + payload.bbcode, false);
            return;
        }

        var message = payload && payload.message ? payload.message : 'Image upload failed.';
        wbPostImageSetStatus(message, true);
    };
    xhr.send(data);
    return false;
}

function wbPostPollFields(){
    var fields = [];
    var question = document.getElementById('poll_question');
    if(question){ fields.push(question); }

    var options = document.getElementsByName('poll_options[]');
    for(var i = 0; i < options.length; i++){
        fields.push(options[i]);
    }
    return fields;
}

function wbPostPollChoiceRows(){
    if(document.getElementsByClassName){
        return document.getElementsByClassName('corebb-poll-choice-row');
    }

    var rows = [];
    var allRows = document.getElementsByTagName('*');
    for(var i = 0; i < allRows.length; i++){
        if((' ' + allRows[i].className + ' ').indexOf(' corebb-poll-choice-row ') >= 0){
            rows.push(allRows[i]);
        }
    }
    return rows;
}

function wbPostPollSetChoiceVisible(choiceNumber, visible){
    var rows = wbPostPollChoiceRows();
    for(var i = 0; i < rows.length; i++){
        if(parseInt(rows[i].getAttribute('data-poll-choice'), 10) === choiceNumber){
            rows[i].style.display = visible ? '' : 'none';
            return rows[i];
        }
    }
    return null;
}

function wbPostPollVisibleChoices(){
    var rows = wbPostPollChoiceRows();
    var visible = 0;
    for(var i = 0; i < rows.length; i++){
        if(rows[i].style.display !== 'none'){
            visible++;
        }
    }
    return visible;
}

function wbPostPollRefreshButtons(){
    var createPoll = document.getElementById('create_poll');
    var toggleButton = document.getElementById('corebbPollToggleButton');
    var addButton = document.getElementById('corebbPollAddChoiceButton');
    var active = createPoll && createPoll.checked;
    var visibleChoices = wbPostPollVisibleChoices();

    if(toggleButton){
        toggleButton.value = active ? 'Remove Poll' : 'Add Poll';
        toggleButton.setAttribute('aria-expanded', active ? 'true' : 'false');
    }
    if(addButton){
        addButton.style.display = active && visibleChoices < 10 ? '' : 'none';
    }
}

function wbPostPollSetActive(active){
    var createPoll = document.getElementById('create_poll');
    if(createPoll){ createPoll.checked = active; }

    var form = document.getElementById('frmMain');
    if(form){
        var className = ' ' + form.className + ' ';
        if(active && className.indexOf(' is-poll-enabled ') < 0){
            form.className = (form.className + ' is-poll-enabled').replace(/^\s+|\s+$/g, '');
        } else if(!active) {
            form.className = className.replace(' is-poll-enabled ', ' ').replace(/^\s+|\s+$/g, '');
        }
    }

    var rows = document.getElementsByClassName ? document.getElementsByClassName('corebb-poll-row') : [];
    if(!document.getElementsByClassName){
        rows = [];
        var allRows = document.getElementsByTagName('*');
        for(var i = 0; i < allRows.length; i++){
            if((' ' + allRows[i].className + ' ').indexOf(' corebb-poll-row ') >= 0){
                rows.push(allRows[i]);
            }
        }
    }

    for(var r = 0; r < rows.length; r++){
        rows[r].style.display = active ? '' : 'none';
    }

    var fields = wbPostPollFields();
    for(var f = 0; f < fields.length; f++){
        fields[f].disabled = !active;
    }

    if(active && wbPostPollVisibleChoices() < 2){
        wbPostPollSetChoiceVisible(1, true);
        wbPostPollSetChoiceVisible(2, true);
    }

    var submitButton = document.getElementById('submitButton');
    if(submitButton){
        submitButton.value = active ? submitButton.getAttribute('data-poll-label') : submitButton.getAttribute('data-topic-label');
    }

    var composerTitle = document.getElementById('corebbPostComposerTitle');
    if(composerTitle){
        composerTitle.innerHTML = active ? composerTitle.getAttribute('data-poll-label') : composerTitle.getAttribute('data-topic-label');
    }

    var composerKicker = document.getElementById('corebbPostComposerKicker');
    if(composerKicker){
        composerKicker.innerHTML = active ? 'Poll' : 'Topic';
    }

    wbPostPollRefreshButtons();
}

function wbPostPollToggle(){
    var createPoll = document.getElementById('create_poll');
    wbPostPollSetActive(!(createPoll && createPoll.checked));
    return false;
}

function wbPostPollAddChoice(){
    var createPoll = document.getElementById('create_poll');
    if(!(createPoll && createPoll.checked)){
        wbPostPollSetActive(true);
    }

    var visibleChoices = wbPostPollVisibleChoices();
    if(visibleChoices >= 10){
        wbPostPollRefreshButtons();
        return false;
    }

    var row = wbPostPollSetChoiceVisible(visibleChoices + 1, true);
    if(row){
        var inputs = row.getElementsByTagName('input');
        if(inputs.length > 0){
            inputs[0].disabled = false;
            inputs[0].focus();
        }
    }

    wbPostPollRefreshButtons();
    return false;
}
</script>

{% set pollEnabled = model.pollChecked|default(false) %}
{% set mode = model.mode|default('new') %}
{% set composerTitle = model.submitLabel|default('Post') %}
{% if mode == 'edit' %}
    {% set composerKicker = 'Edit' %}
{% elseif mode == 'reply' %}
    {% set composerKicker = 'Reply' %}
{% elseif pollEnabled %}
    {% set composerKicker = 'Poll' %}
{% else %}
    {% set composerKicker = 'Topic' %}
{% endif %}

<form name="frmMain" id="frmMain" class="corebb-post-composer{% if pollEnabled %} is-poll-enabled{% endif %}" method="post" action="/post/submit/" enctype="multipart/form-data" onsubmit="return SubmitTheForm(this);">
{% include 'partials/csrf_field.twig' %}

<div class="corebb-post-composer__head">
    <div>
        <div class="corebb-post-composer__kicker" id="corebbPostComposerKicker">{{ composerKicker }}</div>
        <h1 id="corebbPostComposerTitle" data-topic-label="Post New Topic" data-poll-label="Post Poll">{{ composerTitle }}</h1>
    </div>
    {% if model.board.name|default('') is not empty %}
        <div class="corebb-post-composer__board">{{ model.board.name }}</div>
    {% endif %}
</div>

{% if mode == 'reply' %}
<section class="corebb-post-section corebb-post-context" aria-label="Reply context">
    <div class="corebb-post-meta">
        <span>In response to</span>
        <a class="BoardRowBLink" href="{{ model.replyThreadUrl|default('#') }}">{{ model.replyTitle|default('') }}</a>
    </div>
    <div class="corebb-post-meta">
        <span>Posted by</span>
        <a class="AuthorLink" href="/profile/{{ model.posterId|default(0) }}/">{% include 'partials/user_name.twig' with {user: user_name_model(model.posterId|default(0), model.replyPosterName|default('Unknown'), false)} only %}</a>
    </div>
</section>
{% endif %}

<section class="corebb-post-section">
    <label class="corebb-post-label" for="message_subject">Subject</label>
    <input class="corebb-post-input" name="message_subject" maxlength="100" tabindex="1" value="{{ model.subject|default('') }}" id="message_subject" type="text">
</section>

{% if mode == 'edit' %}
<section class="corebb-post-section corebb-post-section--compact">
    <div class="corebb-post-label">Edit time limit</div>
    <strong>{{ model.timeMessage|default('') }}</strong>
</section>
{% endif %}

<section class="corebb-post-section corebb-post-section--format">
    <div class="corebb-post-label">Format</div>
    {% include 'partials/post_toolbar.twig' %}
</section>

{% if model.showSticky|default(false) %}
<section class="corebb-post-section corebb-post-section--compact">
    <div class="corebb-post-label">{{ model.stickyControlLabel|default('Admin') }}</div>
    <label class="corebb-post-check">
        <input type="checkbox" name="issticky" value="checkbox"{% if model.stickyChecked|default(false) %} checked{% endif %}>
        <span>{{ model.stickyText|default('Sticky') }}</span>
    </label>
</section>
{% endif %}

{% if model.showPollControls|default(false) %}
<section class="corebb-post-section corebb-post-section--compact corebb-post-poll-toggle">
    <div class="corebb-post-label">Poll</div>
    <div class="corebb-post-action-row">
        <input class="corebb-sr-only" type="checkbox" name="create_poll" id="create_poll" value="1"{% if pollEnabled %} checked{% endif %}>
        <input class="corebb-post-secondary-button" type="button" id="corebbPollToggleButton" value="{{ pollEnabled ? 'Remove Poll' : 'Add Poll' }}" aria-expanded="{{ pollEnabled ? 'true' : 'false' }}" onclick="return wbPostPollToggle();">
        <span class="corebb-post-note">Question plus two choices minimum.</span>
    </div>
</section>

<section class="corebb-post-section corebb-post-poll-panel corebb-poll-row"{% if not pollEnabled %} style="display: none;"{% endif %}>
    <label class="corebb-post-label" for="poll_question">Poll question</label>
    <input class="corebb-post-input" name="poll_question" id="poll_question" maxlength="255" value="{{ model.pollQuestion|default('') }}" type="text"{% if not pollEnabled %} disabled{% endif %}>

    <div class="corebb-post-label corebb-post-label--choices">Choices</div>
    <div class="corebb-poll-choice-list">
        {% set pollOptions = model.pollOptions|default([]) %}
        {% for i in 0..9 %}
            <div class="corebb-poll-choice-row" data-poll-choice="{{ i + 1 }}"{% if i > 1 %} style="display: none;"{% endif %}>
                <label for="poll_option_{{ i + 1 }}">Choice {{ i + 1 }}</label>
                <input class="corebb-post-input" id="poll_option_{{ i + 1 }}" name="poll_options[]" maxlength="255" value="{{ pollOptions[i]|default('') }}" type="text"{% if not pollEnabled %} disabled{% endif %}>
            </div>
        {% endfor %}
    </div>
    <div class="corebb-post-action-row">
        <input class="corebb-post-secondary-button" type="button" id="corebbPollAddChoiceButton" value="Add Choice" onclick="return wbPostPollAddChoice();">
        <span class="corebb-post-note">Users may vote once.</span>
    </div>
</section>
{% endif %}

{% if model.canUploadImage|default(false) %}
<section class="corebb-post-section corebb-post-upload">
    <div class="corebb-post-label">Admin image</div>
    <div class="corebb-post-upload__controls">
        {% if model.postImageMaxBytes|default(0) > 0 %}
            <input type="hidden" name="MAX_FILE_SIZE" value="{{ model.postImageMaxBytes|default(0) }}">
        {% endif %}
        <input type="hidden" name="post_image_upload_already_inserted" id="post_image_upload_already_inserted" value="0">
        <input type="hidden" id="post_image_upload_endpoint" value="{{ model.postImageUploadEndpoint|default('/post/image-upload/') }}">
        <input type="file" name="post_image_upload" id="post_image_upload" accept="image/png,image/jpeg,image/gif" onchange="wbPostImageResetInsertedFlag();">
        <input class="corebb-post-secondary-button" type="button" id="post_image_upload_button" value="Upload + Insert" onclick="return wbPostImageUploadAndInsert();">
        <span id="post_image_upload_status" class="corebb-post-note"></span>
    </div>
    <div class="corebb-post-note">PNG, GIF, or JPG up to {{ ((model.postImageMaxBytes|default(0)) / 1048576)|number_format(1) }} MB. Large images scale to {{ model.postImageMaxWidth|default(900) }}x{{ model.postImageMaxHeight|default(900) }}.</div>
</section>
{% endif %}

<section class="corebb-post-section corebb-post-message">
    <label class="corebb-post-label" for="message_body">Message</label>
    <textarea class="corebb-post-textarea" name="message_body" cols="60" rows="17" wrap="soft" onselect="pst_fnSaveCaret(this);" onkeyup="pst_fnSaveCaret(this);" onclick="pst_fnSaveCaret(this);" tabindex="2" id="message_body">{{ model.body|default('') }}</textarea>
    <div class="corebb-post-note">
        {{ model.notes|default('Please read the Terms Of Service before posting. By pressing the POST button below, you are agreeing to the TOS.') }}
    </div>
    {% for name, value in model.hidden|default([]) %}
        {% if value != '' %}<input type="hidden" name="{{ name }}" value="{{ value }}">{% endif %}
    {% endfor %}
</section>

<div class="corebb-post-composer__footer">
    <input class="corebb-post-submit" type="submit" name="submitButton" id="submitButton" value="{{ composerTitle }}" data-topic-label="Post New Topic" data-poll-label="Post Poll">
</div>
</form>
{% endif %}
