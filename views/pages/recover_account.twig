<div class="corebb-login-page wb-public-form-workspace">
    <div class="corebb-login-header">
        <div>
            <div class="corebb-login-eyebrow">Account Access</div>
            <h2>Account Recovery</h2>
        </div>
    </div>

    <div class="corebb-login-panel corebb-auth-single">
        {% if model.submitted|default(false) %}
            <div class="corebb-login-section-head">
                <h3>Recovery Request Received</h3>
                <span>{{ model.message|default('') }}</span>
            </div>

            {% if model.mail_error|default('') != '' %}
                <div class="corebb-login-alert">
                    <span class="ErrorFont">{{ model.mail_error }}</span>
                </div>
            {% endif %}

            {% if model.debug_status|default([]) is not empty %}
                <div class="corebb-auth-debug">
                    <table class="corebb-admin-modern-table wb-table">
                        <tr>
                            <th colspan="3">Password Recovery Mail Debug</th>
                        </tr>
                        <tr>
                            <th>Step</th>
                            <th>Status</th>
                            <th>Details</th>
                        </tr>
                        {% for row in model.debug_status %}
                            <tr>
                                <td>{{ row.step|default('') }}</td>
                                <td>{{ row.status|default('') }}</td>
                                <td>{{ row.detail|default('') }}</td>
                            </tr>
                        {% endfor %}
                    </table>
                    <p class="SmallText">This debug block is intended for staging diagnostics. It does not display SMTP passwords or email body contents.</p>
                </div>
            {% endif %}

            <div class="corebb-login-actions corebb-login-actions--start">
                <a class="corebb-login-create-button" href="{{ url('auth.php?action=login') }}">Return to Login</a>
            </div>
        {% else %}
            <form class="corebb-login-form" method="post" action="{{ url('auth.php?action=recover') }}">
                {% include 'partials/csrf_field.twig' %}

                <div class="corebb-login-section-head">
                    <h3>Forgot Password?</h3>
                    <span>Enter the email address on your account. If it matches an account, reset instructions will be emailed to you.</span>
                </div>

                <label class="corebb-login-field">
                    <span>Email Address</span>
                    <input type="email" name="email" maxlength="255" autocomplete="email">
                </label>

                <div class="corebb-login-actions corebb-login-actions--start">
                    <input class="formsubmit corebb-login-submit" type="submit" value="Send Recovery Email">
                    <a class="corebb-login-create-button" href="{{ url('auth.php?action=login') }}">Return to Login</a>
                </div>
            </form>
        {% endif %}
        <form class="corebb-login-form" method="post" action="{{ url('/reset-password/') }}">
            {% include 'partials/csrf_field.twig' %}
            <input type="hidden" name="check_code" value="1">
            <label class="corebb-login-field">Recovery code from your email
                <input name="token" autocomplete="one-time-code" required>
            </label>
            <button class="formsubmit" type="submit">Use recovery code</button>
        </form>
    </div>
</div>
