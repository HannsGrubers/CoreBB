{% set input = model.input|default({}) %}
{% set boards = model.boards|default([]) %}
{% set type = input.type|default('posts') %}
{% set q = input.q|default('') %}
{% set author = input.author|default('') %}
{% set boardId = input.boardid|default(0) %}
{% set resultColspan = type == 'topics' ? 5 : (type == 'users' ? 3 : 4) %}

<div class="corebb-login-page corebb-search-page wb-public-form-workspace">
    <div class="corebb-login-header">
        <div>
            <div class="corebb-login-eyebrow">Forum Search</div>
            <h2>Search CoreBB</h2>
        </div>
    </div>

    <div class="corebb-login-grid corebb-search-grid">
        <form class="corebb-login-panel corebb-login-form corebb-search-form" method="get" action="/search/">
            <div class="corebb-login-section-head">
                <h3>Search Criteria</h3>
                <span>Find posts, topics, or users across the boards you can view.</span>
            </div>

            <label class="corebb-login-field">
                <span>Keyword</span>
                <input class="formtext" type="text" name="q" maxlength="80" value="{{ q }}">
                <small>Minimum 3 characters for keyword searches.</small>
            </label>

            <div class="corebb-login-field">
                <span>Search In</span>
                <div class="corebb-search-choice-row">
                    <label><input type="radio" name="type" value="posts"{{ type == 'posts' ? ' checked' : '' }}> <span>Posts</span></label>
                    <label><input type="radio" name="type" value="topics"{{ type == 'topics' ? ' checked' : '' }}> <span>Topics Only</span></label>
                    <label><input type="radio" name="type" value="users"{{ type == 'users' ? ' checked' : '' }}> <span>Users</span></label>
                </div>
            </div>

            <label class="corebb-login-field">
                <span>Limit to Board</span>
                <select name="boardid" class="formtext">
                    <option value="0">All Boards</option>
                    {% for board in boards %}
                        {% set id = board.id|default(0) %}
                        <option value="{{ id }}"{{ boardId == id ? ' selected' : '' }}>{{ board.name|default('Board') }}</option>
                    {% endfor %}
                </select>
                <small>Ignored for user searches.</small>
            </label>

            <label class="corebb-login-field">
                <span>Posted By</span>
                <input class="formtext" type="text" name="author" maxlength="50" value="{{ author }}">
                <small>Optional username filter for post and topic searches.</small>
            </label>

            <div class="corebb-login-actions">
                <input class="formsubmit corebb-login-submit" type="submit" value="Search">
                <a class="corebb-login-create-button" href="/search/">Reset</a>
            </div>
        </form>

        <aside class="corebb-login-panel corebb-login-side corebb-search-tips">
            <div class="corebb-login-section-head">
                <h3>Search Tips</h3>
                <span>Choose the result type that best matches what you remember.</span>
            </div>

            <div class="corebb-search-tip-list">
                <p><b>Posts</b> searches message bodies and topic titles.</p>
                <p><b>Topics Only</b> searches topic subjects.</p>
                <p><b>Users</b> searches screen names. Board and author filters are ignored for user searches.</p>
            </div>
        </aside>
    </div>
</div>

{% if model.searched|default(false) %}
<div class="corebb-login-page corebb-search-results-page wb-public-form-workspace">
    <div class="corebb-login-header">
        <div>
            <div class="corebb-login-eyebrow">Search Results</div>
            <h2>
                {{ model.total|default(0)|number_format }} result{{ model.total|default(0) == 1 ? '' : 's' }}
                {% if q is not empty %}<span>for "{{ q }}"</span>{% endif %}
            </h2>
        </div>
    </div>

    <div class="corebb-login-panel corebb-search-results-panel">
        {% if model.pagination.visible|default(false) %}
            <div class="corebb-search-pagination">{% include 'partials/board_pagination.twig' with {pagination: model.pagination} only %}</div>
        {% endif %}

        {% if model.message|default('') is not empty %}
            <div class="corebb-login-alert corebb-search-empty"><b>{{ model.message }}</b></div>
        {% elseif type == 'users' %}
            <table class="corebb-search-results-table wb-table">
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Posts</th>
                        <th>Registered</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in model.items|default([]) %}
                        <tr>
                            <td><a class="BoardRowBLink" href="{{ item.url|default('#') }}"><b>{% include 'partials/formatted_content.twig' with {content: search_highlight_model(item.title|default('Unknown'), q)} only %}</b></a></td>
                            <td class="wb-nowrap">{{ item.posts|default(0)|number_format }}</td>
                            <td class="wb-nowrap">{{ item.date|default('') }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="{{ resultColspan }}"><b>No users found.</b></td></tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <table class="corebb-search-results-table wb-table">
                <thead>
                    <tr>
                        <th>Topic / Post</th>
                        <th>Board</th>
                        <th>Author</th>
                        <th>Date</th>
                        {% if type == 'topics' %}<th>Replies</th>{% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% for item in model.items|default([]) %}
                        <tr class="wb-valign-top">
                            <td class="corebb-search-result-main">
                                {% if item.sticky|default(false) %}<span class="SmallText">[Sticky]</span> {% endif %}
                                {% if item.locked|default(false) %}<span class="SmallText">[Locked]</span> {% endif %}
                                <a class="BoardRowBLink" href="{{ item.url|default('#') }}"><b>{% include 'partials/formatted_content.twig' with {content: search_highlight_model(item.title|default('Untitled'), q)} only %}</b></a>
                                {% if item.kind|default('') == 'post' and item.topic_title|default('') != item.title|default('') %}
                                    <span class="corebb-search-result-meta">In topic: {% include 'partials/formatted_content.twig' with {content: search_highlight_model(item.topic_title|default(''), q)} only %}</span>
                                {% endif %}
                                {% if item.excerpt|default('') is not empty %}
                                    <span class="corebb-search-result-excerpt">{% include 'partials/formatted_content.twig' with {content: search_highlight_model(item.excerpt, q)} only %}</span>
                                {% endif %}
                            </td>
                            <td><a class="BoardRowBLink" href="{{ item.board_url|default('#') }}">{{ item.board_name|default('Board') }}</a></td>
                            <td class="wb-nowrap"><a class="BoardRowBLink" href="{{ item.author_url|default('#') }}">{{ item.author|default('Unknown') }}</a></td>
                            <td class="wb-nowrap">{{ item.date|default('') }}</td>
                            {% if type == 'topics' %}<td class="wb-text-center">{{ item.replies|default(0) }}</td>{% endif %}
                        </tr>
                    {% else %}
                        <tr><td colspan="{{ resultColspan }}"><b>No results found.</b></td></tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}

        {% if model.pagination.visible|default(false) %}
            <div class="corebb-search-pagination">{% include 'partials/board_pagination.twig' with {pagination: model.pagination} only %}</div>
        {% endif %}
    </div>
</div>
{% endif %}
