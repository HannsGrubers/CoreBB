{% set page = '/admin/?act=edit_rights' %}
{% set user = model.user %}
<div class="admin-overview admin-settings admin-members admin-rights">
    <header class="admin-dash-heading"><h1>Edit User Rights</h1><a href="{{ url('/admin/') }}">Dashboard</a></header>
    <form class="admin-settings-form admin-member-search" method="get" action="{{ url('/admin/') }}">
        <input type="hidden" name="act" value="edit_rights">
        <div class="admin-auth-field"><label for="rights-lookup">Username or user ID</label>
            <input id="rights-lookup" type="search" name="user" value="{{ model.search_value }}" autocomplete="off" required>
        </div>
        <div class="admin-settings-save"><button type="submit">Find member</button></div>
    </form>
    {% include 'partials/admin_messages.twig' with {messages:model.messages, errors:model.errors} only %}
    {% if user %}
    <section class="admin-member-head" aria-label="Selected member">
        <div><h2>{{ user.username }}</h2><p class="admin-history-count">#{{ user.id }} · {{ user.level_name }}{% if user.registered %} · Registered {{ user.registered }}{% endif %}</p></div>
        <div class="admin-member-links">
            {% if model.can_view_user_pages %}<a href="{{ url('/admin/?act=user_pages&userid=' ~ user.id) }}">User Pages</a>{% endif %}
            <a href="{{ url(user.profile_url) }}">Public profile</a>
        </div>
    </section>
    {% if model.mode == 'confirm' %}
    <section aria-labelledby="rights-review-title">
        <h2 id="rights-review-title">Review changes</h2>
        <dl class="admin-member-facts">
            <dt>Role</dt><dd>{{ user.level_name }}{% if model.selected_level != user.accesslevel %} → <strong>{{ model.levels[model.selected_level] }}</strong>{% endif %}</dd>
            {% if model.can_manage_tool_grants %}
                <dt>Direct grants to add</dt><dd>{{ model.added ? model.added|join(', ') : 'None' }}</dd>
                <dt>Direct grants to remove</dt><dd>{{ model.removed ? model.removed|join(', ') : 'None' }}</dd>
            {% endif %}
            <dt>Access after saving</dt><dd>{{ model.tool_summary.inherited }} {{ model.tool_summary.inherited == 1 ? 'tool' : 'tools' }} from role · {{ model.tool_summary.explicit }} extra {{ model.tool_summary.explicit == 1 ? 'grant' : 'grants' }}</dd>
        </dl>
        {% if model.can_manage_tool_grants and (model.tool_summary.inherited or model.tool_summary.explicit) %}
        <details class="admin-rights-group">
            <summary>See tools available after saving</summary>
            <dl class="admin-member-facts">{% for group,tools in model.tool_groups %}
                {% set granted = tools|filter(tool => tool.inherited or tool.selected) %}
                {% if granted %}<dt>{{ group }}</dt><dd>{{ granted|map(tool => tool.label)|join(', ') }}</dd>{% endif %}
            {% endfor %}</dl>
        </details>
        {% endif %}
        <form class="admin-settings-save admin-rights-buttons" method="post" action="{{ url(page ~ '&method=save') }}">
            {% include 'partials/csrf_field.twig' %}
            <input type="hidden" name="userid" value="{{ user.id }}">
            <input type="hidden" name="review_token" value="{{ model.review_token }}">
            <button type="submit">Save rights</button>
            <button class="admin-rights-secondary" type="submit" formaction="{{ url(page ~ '&method=revise') }}">Back to editing</button>
        </form>
    </section>
    {% else %}
    <form class="admin-settings-form admin-rights-form" method="post" action="{{ url(page ~ '&method=confirm') }}">
        {% include 'partials/csrf_field.twig' %}
        <input type="hidden" name="userid" value="{{ user.id }}">
        <input type="hidden" name="revision" value="{{ model.revision }}">
        {% include 'partials/admin_role_choices.twig' with {levels:model.levels, role_details:model.role_details, selected_level:model.selected_level, marker_level:user.accesslevel, marker:'Current'} only %}
        {% if model.can_manage_tool_grants %}
        <section class="rights-library" aria-labelledby="rights-grants-title">
            <header class="rights-library-head">
                <div><h2 id="rights-grants-title">Tool permissions</h2>
                    <p class="admin-history-count">Grant individual tools beyond the selected role.</p>
                </div>
                <label class="rights-search" hidden><span class="corebb-sr-only">Search all tools</span>
                    <input type="search" placeholder="Search all tools" autocomplete="off">
                </label>
            </header>
            <div class="rights-browser">
                <nav class="rights-categories" aria-label="Permission filters" hidden>
                    <button type="button" data-filter="direct">Direct grants <span data-direct-total>{{ model.tool_summary.explicit }}</span></button>
                    <button type="button" data-filter="all">All tools <span>{{ model.tool_summary.total }}</span></button>
                    {% for group,tools in model.tool_groups %}
                        <button type="button" data-filter="{{ group }}">{{ group }} <span>{{ tools|length }}</span></button>
                    {% endfor %}
                </nav>
                <div class="rights-results">
                    <h3 data-filter-title hidden></h3>
                    <div class="rights-table-scroll"><table aria-label="Tool permission assignments">
                        <thead><tr><th scope="col">Tool</th><th scope="col">Access source</th><th scope="col">Included role</th></tr></thead>
                        {% for group, tools in model.tool_groups %}
                        <tbody data-tool-group="{{ group }}">
                            <tr class="rights-group-title"><th colspan="3" scope="rowgroup">{{ group }}</th></tr>
                            {% for tool in tools %}
                            <tr data-tool-label="{{ tool.label }}" data-access="{{ tool.inherited ? 'inherited' : (tool.selected ? 'direct' : 'available') }}">
                                <th scope="row"><label>
                                    <input type="checkbox" name="admin_tools[]" value="{{ tool.key }}" data-min-level="{{ tool.min_level }}"{% if tool.selected %} checked{% endif %}>
                                    <span>{{ tool.label }}</span>
                                </label></th>
                                <td><span class="rights-source" data-source>{{ tool.inherited ? 'Inherited' : (tool.selected ? 'Direct grant' : 'Available') }}</span></td>
                                <td class="rights-included"><span class="rights-mobile-role">Included with </span>{{ tool.min_level_label }}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                        {% endfor %}
                    </table></div>
                    <p class="rights-empty" hidden></p>
                </div>
            </div>
        </section>
        {% endif %}
        <div class="admin-settings-save rights-save">
            <p aria-live="polite"><strong data-role-summary>{{ model.levels[model.selected_level]|default('Choose a role') }}</strong>
                <span data-access-summary>{{ model.tool_summary.inherited }} inherited · {{ model.tool_summary.explicit }} direct</span>
            </p>
            <button type="submit">Review changes</button>
        </div>
    </form>
    <script nonce="{{ csp_nonce() }}">
    (() => {
        const form = document.querySelector('.admin-rights-form');
        const inputs = [...form.querySelectorAll('input[data-min-level]')];
        const direct = new Set(inputs.filter(input => input.checked).map(input => input.value));
        const groups = [...form.querySelectorAll('[data-tool-group]')];
        const nav = form.querySelector('.rights-categories');
        const search = form.querySelector('.rights-search input');
        const title = form.querySelector('[data-filter-title]');
        const empty = form.querySelector('.rights-empty');
        let filter = '{{ model.tool_summary.explicit ? 'direct' : 'all' }}';

        function showTools() {
            const query = search.value.trim().toLowerCase();
            let visible = 0;
            for (const group of groups) {
                let count = 0;
                for (const row of group.querySelectorAll('[data-tool-label]')) {
                    const match = query ? row.dataset.toolLabel.toLowerCase().includes(query)
                        : filter === 'all' || filter === group.dataset.toolGroup || (filter === 'direct' && row.dataset.access === 'direct');
                    row.hidden = !match;
                    if (match) count++;
                }
                group.hidden = count === 0;
                group.querySelector('.rights-group-title').hidden = !query && filter !== 'all';
                visible += count;
            }
            for (const button of nav.querySelectorAll('button')) {
                button.setAttribute('aria-pressed', String(!query && button.dataset.filter === filter));
            }
            title.textContent = query ? 'Search results' : (filter === 'all' ? 'All tools' : (filter === 'direct' ? 'Direct grants' : filter));
            empty.hidden = visible !== 0;
            empty.textContent = query ? 'No tools match your search.' : 'This member has no extra tool grants for the selected role.';
            form.querySelector('.rights-results table').hidden = !visible;
        }

        function refresh() {
            const role = form.querySelector('input[name=userlevel]:checked');
            if (!role) return;
            let extras = 0;
            for (const input of inputs) {
                const row = input.closest('tr');
                input.disabled = Number(role.value) >= Number(input.dataset.minLevel);
                input.checked = input.disabled || direct.has(input.value);
                row.dataset.access = input.disabled ? 'inherited' : (input.checked ? 'direct' : 'available');
                row.querySelector('[data-source]').textContent = input.disabled ? 'Inherited' : (input.checked ? 'Direct grant' : 'Available');
                if (!input.disabled && input.checked) extras++;
            }
            form.querySelector('[data-role-summary]').textContent = role.dataset.roleLabel;
            if (nav) {
                nav.querySelector('[data-direct-total]').textContent = extras;
                form.querySelector('[data-access-summary]').textContent = role.dataset.inherited + ' inherited · ' + extras + ' direct';
                showTools();
            } else {
                form.querySelector('[data-access-summary]').textContent = role.dataset.inherited + ' inherited';
            }
        }

        form.addEventListener('change', event => {
            if (event.target.matches('input[data-min-level]')) {
                if (event.target.checked) direct.add(event.target.value);
                else direct.delete(event.target.value);
            }
            refresh();
            if (event.target.closest('tr[hidden]')) nav.querySelector('[aria-pressed="true"]').focus();
        });
        if (nav) {
            nav.hidden = search.closest('label').hidden = title.hidden = false;
            nav.addEventListener('click', event => {
                const button = event.target.closest('button[data-filter]');
                if (!button) return;
                search.value = '';
                filter = button.dataset.filter;
                showTools();
            });
            search.addEventListener('input', showTools);
            showTools();
        }
        refresh();
    })();
    </script>
    {% endif %}
    {% endif %}
</div>
