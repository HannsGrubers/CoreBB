{% set page = '/admin/?act=view_message' %}
{% set post = model.post %}
<div class="admin-overview admin-settings admin-members message-reader">
    <header class="admin-dash-heading"><h1>View a Message</h1>
        <div class="board-dir-links">{% if model.can_view_bin %}<a href="{{ url('/admin/?act=deleted_posts') }}">Deleted Posts</a>{% endif %}<a href="{{ url('/admin/') }}">Dashboard</a></div>
    </header>
    {% if model.can_view_bin is defined %}
    <form class="admin-settings-form admin-member-search" method="get" action="{{ url('/admin/') }}">
        <input type="hidden" name="act" value="view_message"><input type="hidden" name="method" value="view">
        <div class="admin-auth-field"><label for="lookup-message">Message ID</label>
            <input id="lookup-message" name="messageid" type="text" inputmode="numeric" pattern="[0-9]+" value="{{ model.messageid }}" autocomplete="off"{% if not post %} aria-describedby="lookup-message-help"{% endif %} required>
        </div>
        <div class="admin-settings-save"><button type="submit">Find message</button></div>
    </form>
    {% if not post %}<p class="admin-history-count" id="lookup-message-help">Use the message ID shown in the information menu on a forum post.</p>{% endif %}
    {% endif %}
    {% include 'partials/admin_messages.twig' with {messages:model.messages,errors:model.errors} only %}
    {% if model.message|default('') %}<p>{{ model.message|replace({'+':' '}) }}</p>{% endif %}
    {% if post %}
    {% set poster = model.poster %}
    <section class="message-record" aria-labelledby="message-title">
        <header class="message-heading">
            <p class="message-location"><a href="{{ model.board_url }}">{{ model.board_name }}</a>
                {% if model.topic_title %}<span aria-hidden="true">›</span> {% if model.topic_url %}<a href="{{ model.topic_url }}">{{ model.topic_title }}</a>{% else %}{{ model.topic_title }}{% endif %}{% endif %}
            </p>
            <div class="message-title"><h2 id="message-title">{{ post.title ?: 'Untitled message' }}</h2><span>#{{ post.id }}</span></div>
        </header>
        {% if model.is_deleted %}<p class="message-deleted"><strong>In Deleted Posts.</strong> This message is hidden from the forum.</p>{% endif %}
        <div class="message-reading">
            <div class="message-byline">
                {% if poster %}<span class="message-avatar">{% include 'partials/user_icon.twig' with {icon:user_icon_model(post.posterid)} only %}</span>{% endif %}
                <div><div class="message-author">
                    {% if poster %}{% include 'partials/user_name.twig' with {user:user_name_model(post.posterid,poster.username)} only %}
                        {% include 'partials/user_star.twig' with {star:user_star_model(poster.posts,post.posterid)} only %}
                    {% else %}<strong>{{ post.author ?: 'Unknown author' }}</strong>{% endif %}
                </div>
                <span class="admin-history-count">{{ model.post_date }}</span></div>
            </div>
            <div class="message-body">{% include 'partials/formatted_content.twig' with {content:post_body_model(post.body,poster.accesslevel|default(0))} only %}</div>
            {% if model.post_edit.was_edited %}<p class="message-edit-meta">Edited {{ model.post_edit.date }} by
                {% include 'partials/user_name.twig' with {user:user_name_model(model.post_edit.edited_by_id,'Unknown editor')} only %}
                · {{ model.post_edit.count }} {{ model.post_edit.count == 1 ? 'edit' : 'edits' }}</p>{% endif %}
            {% if poster %}<details class="message-author-details"><summary>Author details</summary>
                <dl class="admin-member-facts"><dt>Role</dt><dd>{{ poster.level_name }}</dd><dt>Posts</dt><dd>{{ poster.posts|number_format }}</dd>
                {% if poster.registered %}<dt>Registered</dt><dd>{{ poster.registered }}</dd>{% endif %}</dl>
            </details>{% endif %}
        </div>
        {% if model.modify_block_reason and not model.is_deleted %}
            <p class="message-readonly">{{ model.modify_block_reason }}</p>
        {% elseif not model.is_deleted %}
        <div class="message-tools">
            <details class="message-edit"{% if model.draft %} open{% endif %}><summary>Edit message</summary>
                <form class="admin-settings-form" method="post" action="{{ url(page ~ '&method=edit&messageid=' ~ post.id) }}">
                    {{ _self.fields(post.id,model.revision) }}
                    <div class="admin-auth-field"><label for="message-subject">Subject</label><input id="message-subject" name="message_subject" type="text" value="{{ model.draft.title ?? post.title }}"></div>
                    <div class="admin-auth-field"><label for="message-body">Message</label><textarea id="message-body" name="message_body" rows="9">{{ model.draft.body ?? post.body }}</textarea></div>
                    <div class="admin-settings-save"><button type="submit">Save edit</button></div>
                </form>
            </details>
            <details class="message-remove"><summary>Move to Deleted Posts</summary>
                <p>The message can be restored. Moving the last visible message also hides its topic.</p>
                <form method="post" action="{{ url(page ~ '&method=delete&messageid=' ~ post.id) }}">
                    {{ _self.fields(post.id,model.revision) }}
                    <button type="submit" class="admin-member-remove">Confirm move</button>
                </form>
            </details>
        </div>
        {% endif %}
    </section>
    {% if model.continue_url|default('') and (model.can_view_bin or 'act=deleted_posts' not in model.continue_url) %}<p><a href="{{ url(model.continue_url) }}">Continue</a></p>{% endif %}
    {% endif %}
</div>
{% macro fields(id,revision) %}
    {% include 'partials/csrf_field.twig' %}
    <input type="hidden" name="messageid" value="{{ id }}"><input type="hidden" name="revision" value="{{ revision }}">
{% endmacro %}
