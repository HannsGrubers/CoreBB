<div class="admin-overview admin-api" data-api-base="{{ model.api_base_path }}">
    <header class="admin-dash-heading">
        <h1>API Explorer</h1>
        <a href="{{ url('/admin/') }}">Dashboard</a>
    </header>

    <section aria-labelledby="api-request-title">
        <h2 id="api-request-title">Request</h2>
        <form class="admin-settings-form admin-api-request" id="api-request">
            <div class="admin-auth-field">
                <label for="api-preset">Preset</label>
                <select id="api-preset">
                    {% for endpoint in model.endpoints %}
                        <option value="{{ endpoint.path }}">{{ endpoint.label }}</option>
                    {% endfor %}
                    <option value="">Custom endpoint</option>
                </select>
            </div>
            <div class="admin-auth-field">
                <label for="api-endpoint">Endpoint</label>
                <input id="api-endpoint" type="text" value="{{ model.default_endpoint }}" autocomplete="off" spellcheck="false" aria-describedby="api-endpoint-help">
            </div>
            <div class="admin-settings-save"><button id="api-send" type="submit" disabled>Send GET</button></div>
        </form>
        <p id="api-endpoint-help" class="admin-history-count">Edit the path to change a record ID or add query parameters.</p>
        <noscript>Enable JavaScript to send a request.</noscript>
    </section>

    <section class="admin-api-response" aria-labelledby="api-response-title">
        <header class="admin-section-head">
            <h2 id="api-response-title">Response</h2>
            <label><input id="api-raw" type="checkbox" disabled> Raw JSON</label>
            <button id="api-copy" type="button" disabled>Copy response</button>
        </header>
        <div class="admin-api-meta" role="status"><strong id="api-status">Ready</strong><span id="api-elapsed"></span><code id="api-requested"></code></div>
        <pre id="api-output" aria-label="Response body" tabindex="0"></pre>
        <span id="api-copy-status" class="admin-history-count" role="status"></span>
    </section>
</div>
<script defer src="{{ asset('scripts/admin_api_explorer.js') }}"></script>
