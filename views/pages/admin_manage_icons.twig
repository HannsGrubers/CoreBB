{% set base = '/admin/?act=manage_icons' %}
{% set action = url(base ~ (model.queryString ? '&' ~ model.queryString : '')) %}
{% set filters = model.filters %}
<div class="admin-overview admin-settings icon-library">
    <header class="admin-dash-heading"><h1>Manage Icons</h1><a href="{{ url('/admin/') }}">Dashboard</a></header>
    {% include 'partials/admin_messages.twig' with {messages:model.messages|default([]),errors:model.errors|default([])} only %}
    {% if model.stats is defined %}
    <nav class="icon-counts" aria-label="Icon library shortcuts">
        {% for key, item in {total:['All icons',''],uploaded:['User uploads','&type=uploaded'],shared:['Shared icons','&type=shared'],approved:['Approved','&status=approved'],unapproved:['Unapproved','&status=unapproved'],unused_uploaded:['Unused uploads','&type=uploaded&usage=unused']} %}
            <a href="{{ url(base ~ item[1]) }}"><strong>{{ model.stats[key]|number_format }}</strong><span>{{ item[0] }}</span></a>
        {% endfor %}
    </nav>
    <details class="icon-upload"{% if model.upload_error|default(false) %} open{% endif %}><summary>Add a shared icon</summary>
        <form class="admin-settings-form" method="post" enctype="multipart/form-data" action="{{ action }}">
            {{ _self.fields(model.token) }}
            <input type="hidden" name="icon_action" value="upload_shared">
            <div class="admin-auth-field"><label for="icon-file">Image file</label>
                <input id="icon-file" type="file" name="shared_icon_file" accept="image/png,image/gif,image/jpeg" aria-describedby="icon-file-help" required>
                <small id="icon-file-help">PNG, GIF or JPG · Up to {{ model.maxWidth }} × {{ model.maxHeight }} pixels and {{ (model.maxBytes / 1024)|number_format }} KB.</small>
            </div>
            <div class="admin-auth-field"><label for="icon-name">Display name (optional)</label>
                <input id="icon-name" type="text" name="shared_icon_name" placeholder="Use filename">
            </div>
            <div class="admin-settings-save"><button>Upload shared icon</button></div>
        </form>
    </details>
    <section aria-labelledby="icon-library-heading">
        <header class="admin-section-head"><h2 id="icon-library-heading">Icon library</h2></header>
        <form class="admin-settings-form icon-filters" method="get" action="{{ url('/admin/') }}">
            <input type="hidden" name="act" value="manage_icons">
            <div class="admin-auth-field"><label for="icon-query">Search icons</label>
                <input type="search" id="icon-query" name="q" value="{{ filters.q }}" placeholder="ID, owner, filename or path">
            </div>
            {% for key, options in {type:{all:'All types',uploaded:'User uploads',shared:'Shared icons'},status:{all:'Any status',approved:'Approved',unapproved:'Unapproved'},usage:{all:'Any usage',used:'In use',unused:'Unused'}} %}
                <div class="admin-auth-field"><label for="icon-{{ key }}">{{ key|capitalize }}</label><select id="icon-{{ key }}" name="{{ key }}">
                    {% for value, label in options %}<option value="{{ value }}"{% if filters[key] == value %} selected{% endif %}>{{ label }}</option>{% endfor %}
                </select></div>
            {% endfor %}
            <div class="admin-settings-save"><button>Apply filters</button>
                {% if filters.q != '' or filters.type != 'all' or filters.status != 'all' or filters.usage != 'all' %}<a href="{{ url(base) }}">Reset</a>{% endif %}
            </div>
        </form>
        {% if model.icons %}
        <p class="admin-history-count">{{ ((model.page - 1) * model.perPage + 1)|number_format }}–{{ min(model.page * model.perPage, model.total)|number_format }} of {{ model.total|number_format }} matching {{ model.total == 1 ? 'icon' : 'icons' }}</p>
        <div class="icon-grid">
        {% for icon in model.icons %}
            <article class="icon-card" aria-labelledby="icon-title-{{ icon.id }}">
                <figure class="icon-figure">
                    <div class="icon-tile">{% if icon.src %}<img src="{{ icon.src }}" alt="Preview of {{ icon.alt }}" loading="lazy">{% else %}<span>No preview</span>{% endif %}</div>
                    <figcaption id="icon-title-{{ icon.id }}" title="{{ icon.filename ?: 'Icon ' ~ icon.id }}">{{ icon.filename ?: 'Icon ' ~ icon.id }}</figcaption>
                </figure>
                <div class="icon-review-line"><span class="icon-status {{ icon.is_approved ? 'is-approved' : 'is-unapproved' }}">{{ icon.status_label }}</span>
                    <span>{{ icon.usage_count ? 'Used by ' ~ (icon.usage_count|number_format) : 'Unused' }}</span></div>
                {% if not icon.is_approved %}
                    <form class="admin-settings-save icon-approve" method="post" action="{{ action }}">{{ _self.fields(model.token, icon.id) }}<button name="icon_action" value="approve">Approve icon</button></form>
                {% endif %}
                <details class="icon-manage"><summary>Details and actions</summary>
                    <dl class="icon-facts"><div><dt>Icon</dt><dd>#{{ icon.id }} · {{ icon.is_uploaded ? 'User upload' : 'Shared icon' }}</dd></div>
                    <div><dt>Filename</dt><dd>{{ icon.filename ?: 'Unknown' }}</dd></div>
                    <div><dt>Owner</dt><dd>{% if icon.owner.linked %}<a href="{{ icon.owner.profile_url }}">{{ icon.owner.username }}</a>{% else %}{{ icon.owner.username }}{% endif %}</dd></div>
                    <div><dt>File path</dt><dd>{{ icon.filepath ?: 'Unknown' }}</dd></div>
                    {% if icon.mime %}<div><dt>File type</dt><dd>{{ icon.mime }}</dd></div>{% endif %}
                    {% if icon.uploaded_at_label %}<div><dt>Uploaded</dt><dd>{{ icon.uploaded_at_label }}</dd></div>{% endif %}
                    {% if icon.used_by %}<div><dt>Members</dt><dd>{{ icon.used_by }}</dd></div>{% endif %}</dl>
                    {% if icon.is_approved and icon.usage_count %}<p class="admin-history-count">Unapproving clears this icon from the profiles using it.</p>{% endif %}
                    <form class="admin-settings-save icon-actions" method="post" action="{{ action }}">
                        {{ _self.fields(model.token, icon.id) }}
                        {% if icon.is_approved %}<button name="icon_action" value="unapprove">Unapprove</button>{% endif %}
                        <button name="icon_action" value="{{ icon.is_uploaded ? 'make_shared' : 'make_uploaded' }}">{{ icon.is_uploaded ? 'Make shared' : 'Make user upload' }}</button>
                    </form>
                    <details class="icon-remove"><summary>Delete icon</summary>
                        <p>Remove icon #{{ icon.id }}? Members using it will be reset to no icon.</p>
                        <form method="post" action="{{ action }}">{{ _self.fields(model.token, icon.id) }}
                            <button class="admin-member-remove" name="icon_action" value="delete">Confirm deletion</button>
                        </form>
                    </details>
                </details>
            </article>
        {% endfor %}
        </div>
        {% if model.pagination.visible %}<nav class="admin-latest-pager" aria-label="Icon pages">
            {% if model.pagination.prev.enabled %}<a rel="prev" href="{{ url(model.pagination.prev.url) }}">Previous</a>{% endif %}
            {% for item in model.pagination.items %}{% if item.type == 'ellipsis' %}<span>…</span>{% elseif item.current %}<strong aria-current="page">{{ item.page }}</strong>{% else %}<a href="{{ url(item.url) }}" aria-label="Page {{ item.page }}">{{ item.page }}</a>{% endif %}{% endfor %}
            {% if model.pagination.next.enabled %}<a rel="next" href="{{ url(model.pagination.next.url) }}">Next</a>{% endif %}
        </nav>{% endif %}
        {% else %}<p>{% if model.stats.total %}No icons match these filters. <a href="{{ url(base) }}">Show all icons</a>{% else %}The icon library is empty.{% endif %}</p>{% endif %}
    </section>
    <details class="icon-cleanup"><summary>Clean up unused uploads <small>({{ model.stats.unused_uploaded|number_format }})</small></summary>
        <p>This removes every user-uploaded icon that no member uses, across the entire library. Shared icons are kept.</p>
        <form method="post" action="{{ action }}">{{ _self.fields(model.token) }}
            <button name="icon_action" value="delete_unused_uploaded" class="admin-member-remove"{% if not model.stats.unused_uploaded %} disabled{% endif %}>Confirm deletion of unused uploads</button>
        </form>
    </details>
    {% endif %}
</div>
{% macro fields(token,id) %}
    {% include 'partials/csrf_field.twig' %}
    <input type="hidden" name="admin_icons_token" value="{{ token }}">
    {% if id %}<input type="hidden" name="icon_id" value="{{ id }}">{% endif %}
{% endmacro %}
