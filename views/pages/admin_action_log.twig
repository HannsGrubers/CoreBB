{% set base = '/admin/?act=action_log' %}
<div class="admin-overview admin-settings audit-log">
    <header class="admin-dash-heading"><h1>Admin Action Log</h1>
        <nav class="board-dir-links" aria-label="Action log links">
            {% if model.reload_url %}<a href="{{ url(model.reload_url) }}">Reload log</a>{% endif %}
            <a href="{{ url('/admin/') }}">Dashboard</a>
        </nav>
    </header>
    {% include 'partials/admin_messages.twig' with {messages:[],errors:model.errors|default([])} only %}
    {% if model.filters is defined %}
    <form class="admin-settings-form audit-filters" method="get" action="{{ url('/admin/') }}">
        <input type="hidden" name="act" value="action_log">
        <div class="admin-auth-field"><label for="audit-action">Action</label><input type="search" name="actiontype" id="audit-action" value="{{ model.filters.actiontype }}" placeholder="Action, type, or description"></div>
        <div class="admin-auth-field"><label for="audit-staff">Staff member</label><input type="search" name="susername" id="audit-staff" value="{{ model.filters.susername }}" placeholder="Username or ID"></div>
        <div class="admin-auth-field"><label for="audit-ip">IP address</label><input type="search" name="ip" id="audit-ip" value="{{ model.filters.ip }}" spellcheck="false"></div>
        <div class="admin-settings-save"><button type="submit">Search log</button>{% if model.filtered %}<a href="{{ url(base) }}">Reset</a>{% endif %}</div>
    </form>
    {% endif %}
    {% if model.total is defined %}
    <section class="audit-results" aria-label="Logged actions">
        {% if model.rows %}
        <p class="audit-range">{{ model.first|number_format }}–{{ model.last|number_format }} of {{ model.total|number_format }} {{ model.filtered ? 'matching ' : '' }}{{ model.total == 1 ? 'action' : 'actions' }} · Newest first</p>
        <div class="audit-columns" aria-hidden="true"><span>Action</span><span>Staff member</span><span>When</span></div>
        {% for row in model.rows %}
        <details class="audit-entry" name="audit-record">
            <summary><strong>{{ row.action }}</strong><span class="audit-actor">{{ row.admin_username }}</span><span class="audit-date">{{ row.date_vn }}</span></summary>
            <div class="audit-detail">
                {% if row.detail %}<p class="audit-description">{{ row.detail }}</p>{% endif %}
                <dl>
                    <div><dt>Action type</dt><dd>{% if row.type_filter_url %}<a href="{{ url(row.type_filter_url) }}" title="Filter by this action type">{{ row.type }}</a>{% else %}{{ row.type }}{% endif %}</dd></div>
                    <div><dt>IP address</dt><dd>{% if row.ip_filter_url %}<a href="{{ url(row.ip_filter_url) }}" title="Filter by this IP address">{{ row.ip }}</a>{% else %}Not recorded{% endif %}</dd></div>
                    {% if row.role %}<div><dt>Role at the time</dt><dd>{{ row.role }}</dd></div>{% endif %}
                    {% if row.recorded_name %}<div><dt>Recorded username</dt><dd>{{ row.recorded_name }}</dd></div>{% endif %}
                    {% if row.id %}<div><dt>Log entry</dt><dd>#{{ row.id }}</dd></div>{% endif %}
                </dl>
                {% if row.actor_filter_url %}<a href="{{ url(row.actor_filter_url) }}">Filter by this staff member</a>{% endif %}
            </div>
        </details>{% endfor %}
        {% elseif model.filtered %}<p>No actions match these filters. <a href="{{ url(base) }}">Show all actions</a></p>
        {% else %}<p>No actions have been recorded.</p>{% endif %}
        {% if model.pagination.visible %}
        <nav class="admin-latest-pager" aria-label="Log pages">
            {% if model.pagination.prev.enabled %}<a rel="prev" href="{{ url(model.pagination.prev.url) }}">Previous</a>{% endif %}
            {% for item in model.pagination.items %}{% if item.type == 'ellipsis' %}<span>…</span>{% elseif item.current %}<strong aria-current="page">{{ item.page }}</strong>{% else %}<a href="{{ url(item.url) }}" aria-label="Page {{ item.page }}">{{ item.page }}</a>{% endif %}{% endfor %}
            {% if model.pagination.next.enabled %}<a rel="next" href="{{ url(model.pagination.next.url) }}">Next</a>{% endif %}
        </nav>
        {% endif %}
    </section>
    {% endif %}
</div>
