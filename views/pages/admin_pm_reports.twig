{% set base = '/admin/?act=pm_reports' %}
{% set report = model.detail|default(null) %}
<div class="admin-overview admin-settings admin-members appeals-workspace contact-inbox pm-report-workspace">
    <header class="admin-dash-heading">
        <h1>{{ report ? 'Review private message report' : 'Private Message Reports' }}</h1>
        {% if model.requests is defined %}<a href="{{ url('/admin/') }}">Dashboard</a>
        {% elseif model.queue_url %}<a href="{{ url(model.queue_url) }}">Back to {{ model.old ? 'handled reports' : 'open reports' }}</a>{% endif %}
    </header>
    {% include 'partials/admin_messages.twig' with {messages:model.messages|default([]), errors:model.errors|default([])} only %}
    {% if model.requests is defined %}
        <nav class="appeal-tabs" aria-label="Report queues">
            <a href="{{ url(base) }}"{% if not model.old %} aria-current="page"{% endif %}>Open reports</a>
            <a href="{{ url(base ~ '&old=yes') }}"{% if model.old %} aria-current="page"{% endif %}>Handled reports</a>
        </nav>
        {% if model.requests %}
            <p class="admin-history-count">{{ model.first|number_format }}–{{ model.last|number_format }} of {{ model.total|number_format }} · Highest severity first</p>
            <table class="contact-list">
                <thead><tr><th scope="col">Reported message</th><th scope="col">Severity</th><th scope="col">{{ model.old ? 'Outcome' : 'Reported by' }}</th><th scope="col">Received</th></tr></thead>
                <tbody>{% for item in model.requests %}<tr>
                    <td><a class="report-subject" href="{{ url(item.detail_url) }}">{{ item.title ?: 'Private message #' ~ item.pmid }}</a>
                        <span class="contact-preview">{{ item.reason_type|replace({'_':' '}) }}</span></td>
                    <td><span class="report-severity" data-high="{{ item.severity >= 4 ? 'yes' : 'no' }}"><span class="contact-mobile-label">Severity </span>{{ item.severity }}</span></td>
                    <td>{% if model.old %}{{ item.outcome }}{% else %}<span class="contact-mobile-label">By </span>{{ item.reporter_username ?: 'Member #' ~ item.reporterid }}{% endif %}</td>
                    <td>{{ item.created_at ?: 'Date unavailable' }}</td>
                </tr>{% endfor %}</tbody>
            </table>
            {% include 'partials/admin_queue_pager.twig' with {pager:model.pagination, label:'Report pages'} only %}
        {% else %}<p class="appeal-empty">{{ model.old ? 'No handled reports yet.' : 'No open private message reports.' }}</p>{% endif %}
    {% elseif report %}
        <article class="admin-title-editor">
            <header class="admin-member-head"><div>
                <h2>{{ report.title ?: (report.message_id ? 'Untitled private message' : 'Message unavailable') }}</h2>
                <p class="admin-history-count">Report #{{ report.id }} · PM #{{ report.pmid }}</p>
            </div></header>
            <div class="report-reading">
                <section class="report-complaint">
                    <h3>{{ report.reason_type|replace({'_':' '}) ?: 'Report' }}</h3>
                    <p class="admin-history-count">Severity {{ report.severity }} · Reported by {{ _self.member(report.reporter_username,report.reporterid,model.can_view_member) }}
                        {% if report.created_at %} · {{ report.created_at }}{% endif %}</p>
                    {% if report.comments %}<blockquote>{{ report.comments }}</blockquote>{% endif %}
                </section>
                <section>
                    <h3>Reported message</h3>
                    <p class="admin-history-count">From {{ _self.member(report.sender_username,report.senderid,model.can_view_member) }}
                        to {{ _self.member(report.receiver_username,report.recieveid,model.can_view_member) }}{% if report.datesent %} · {{ report.datesent }}{% endif %}</p>
                    {% if report.message_id %}<div class="contact-body">{{ report.message }}</div>
                    {% else %}<p>The original message is unavailable.</p>{% endif %}
                    {% if report.is_deleted and (report.status != 'deleted' or report.deleted_by != report.handled_by or report.deleted_at != report.handled_at) %}
                        <p class="admin-history-count">Removed from mailboxes{% if report.deleted_by_username or report.deleted_by %} by {{ report.deleted_by_username ?: 'staff #' ~ report.deleted_by }}{% endif %}{% if report.deleted_at %} · {{ report.deleted_at }}{% endif %}</p>
                    {% elseif report.status == 'deleted' and report.message_id and not report.is_deleted %}
                        <p class="admin-history-count">Currently visible in mailboxes.</p>
                    {% endif %}
                </section>
            </div>
            {% if report.status != 'new' %}
                <section class="contact-compose"><h3>{{ model.outcome }}</h3>
                    <p class="admin-history-count">{{ report.handler_username ?: (report.handled_by ? 'Staff #' ~ report.handled_by : 'Staff member unavailable') }}{% if report.handled_at %} · {{ report.handled_at }}{% endif %}</p>
                    {% if report.handler_note %}<h4>Staff note</h4><div class="contact-body">{{ report.handler_note }}</div>{% endif %}
                </section>
            {% elseif model.can_act %}
                <form class="admin-settings-form appeal-decision" method="post" action="{{ url(model.action_url) }}">
                    {% include 'partials/csrf_field.twig' %}
                    <input type="hidden" name="report_id" value="{{ report.id }}">
                    <fieldset><legend>Decision</legend><div class="appeal-options">
                        <label><input type="radio" name="action" value="cancel_report" required>
                            <span><strong>Close report</strong><small>Keep the message as it is.</small></span></label>
                        {% if model.can_remove %}<label><input type="radio" name="action" value="delete_pm" required>
                            <span><strong>Remove message</strong><small>Remove it from both mailboxes and close its open reports.</small></span></label>{% endif %}
                    </div></fieldset>
                    <div class="admin-auth-field"><label for="pm-report-note">Staff note (optional)</label>
                        <textarea rows="3" id="pm-report-note" maxlength="65535" name="handler_note">{{ model.draft_note }}</textarea></div>
                    <div class="admin-settings-save"><button type="submit">Confirm decision</button><a href="{{ url(model.queue_url) }}">Cancel</a></div>
                </form>
            {% else %}<p class="contact-compose">{{ model.blocked_reason }}</p>{% endif %}
        </article>
    {% endif %}
</div>
{% macro member(name,id,linked) %}
    {% if linked and name %}<a href="{{ url('/admin/?act=user_pages&userid=' ~ id) }}">{{ name }}</a>{% else %}{{ name ?: 'Member #' ~ id }}{% endif %}
{% endmacro %}
