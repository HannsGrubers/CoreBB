{% set r=model.report|default(null) %}{% set p=model.post|default(null) %}
<div class="admin-overview admin-settings admin-members reports-workspace">
    <header class="admin-dash-heading"><h1>{{ r ? 'Review post report' : 'Moderate message' }}</h1>
        <a href="{{ url(model.queue_url|default('/admin/?act=mod_requests')) }}">Back to reports</a></header>
    {% include 'partials/admin_messages.twig' with {messages:model.messages|default([]),errors:model.errors|default([])} only %}
    {% if model.missing %}{% if model.message %}<p>{{ model.message }}</p>{% endif %}{% else %}
    <section class="admin-title-editor">
        <header class="admin-member-head"><div><h2>{{ p ? p.title : 'Message unavailable' }}</h2>
            <p class="admin-history-count">{{ r ? r.board : p.board }} · Post #{{ r ? r.postid : p.id }}{% if r %} · Report #{{ r.id }}{% endif %}</p></div>
            {% if p and p.thread_url and not p.deleted %}<a href="{{ p.thread_url }}">Open in thread</a>{% endif %}
        </header>
        <div class="report-reading">
            {% if r %}<section class="report-complaint"><h3>{{ r.reason ?: 'Report' }}</h3>
                <p class="admin-history-count">Severity {{ r.severity }} · Reported by {% if model.access.user_pages %}<a href="{{ url('/admin/?act=user_pages&userid=' ~ r.reporterid) }}">{{ r.reporter }}</a>{% else %}{{ r.reporter }}{% endif %} · {{ r.created }}</p>
                {% if r.comments %}<blockquote>{{ r.comments }}</blockquote>{% endif %}
                {% if not p and r.reported_userid %}<p class="admin-history-count">Reported member · {% if model.access.user_pages %}<a href="{{ url('/admin/?act=user_pages&userid=' ~ r.reported_userid) }}">#{{ r.reported_userid }}</a>{% else %}#{{ r.reported_userid }}{% endif %}</p>{% endif %}
            </section>{% endif %}
            {% if p %}<section><h3>Message</h3><p class="admin-history-count">{% if model.access.user_pages %}<a href="{{ url('/admin/?act=user_pages&userid=' ~ p.author_id) }}">{{ p.author }}</a>{% else %}{{ p.author }}{% endif %} · {{ p.date }}{% if p.deleted %} · In Deleted Posts{% endif %}</p>
                <div class="message-body">{% include 'partials/formatted_content.twig' with {content:post_body_model(p.body,p.level)} only %}</div>
                <div class="report-links">
                    {% if model.can_edit %}<a href="{{ url('/post/edit/' ~ p.id ~ '/?mod=1') }}">Edit or lock message</a>{% endif %}
                    {% if model.access.admin_notes and p.author_id %}<a href="{{ url('/admin/?act=admin_notes&uid=' ~ p.author_id) }}">Staff notes</a>{% endif %}
                    {% if model.access.moderation_ban and p.author_id %}<a href="{{ url('/admin/?act=moderation&mode=ban&q=' ~ p.author_id) }}">Review account ban</a>{% endif %}
                </div>
                {% if p.user_ip or p.post_ip %}<details class="report-addresses"><summary>IP addresses</summary>
                    {% for label,ip in {'Last account IP':p.user_ip,'Post IP':p.post_ip} %}{% if ip %}<p>{{ label }} · {{ ip }}
                        {% if model.access.user_ip_check %}<a href="{{ url('/admin/?act=user_ip_check&ip=' ~ ip|url_encode) }}">IP check</a>{% endif %}
                        {% if model.access.host_lookup %}<a href="{{ url('/admin/?act=host_lookup&ip_address=' ~ ip|url_encode) }}">Host lookup</a>{% endif %}
                    </p>{% endif %}{% endfor %}
                </details>{% endif %}
            </section>{% endif %}
        </div>
        {% if r and r.status != 'new' %}
            <div class="report-resolution"><h3>{{ r.label }}</h3><p class="admin-history-count">{{ r.handler ?: 'Staff member not recorded' }}{% if r.handled %} · {{ r.handled }}{% endif %}</p>
                {% if r.note %}<p class="appeal-response">{{ r.note }}</p>{% endif %}
                <form method="post" action="{{ url(model.action_url) }}" class="admin-settings-save">{{ _self.fields(model,r,p) }}<button name="action" value="reopen_request">Reopen report</button></form>
            </div>
        {% elseif r or model.can_remove_post or model.can_remove_topic %}
        <form class="admin-settings-form appeal-decision" method="post" action="{{ url(model.action_url) }}">
            {{ _self.fields(model,r,p) }}
            <fieldset><legend>Decision</legend><div class="appeal-options">
                {% if r %}<label><input name="action" value="close_request" type="radio" required><span><strong>Close report</strong><small>Keep the content as it is.</small></span></label>{% endif %}
                {% if model.can_remove_post %}<label><input name="action" value="remove_message" type="radio" required><span><strong>Remove post</strong><small>Move this reply to Deleted Posts.</small></span></label>{% endif %}
                {% if model.can_remove_topic %}<label><input name="action" value="remove_topic" type="radio" required><span><strong>Remove topic</strong><small>Move the entire thread and its replies to Deleted Posts.</small></span></label>{% endif %}
            </div></fieldset>
            {% if model.opening_post and model.can_remove_topic %}<p class="admin-history-count">This is the opening post. Removing it affects the whole topic.</p>{% endif %}
            {% if r %}<div class="admin-auth-field"><label for="report-note">Handling note (optional)</label><textarea id="report-note" name="handler_note" rows="3" maxlength="65535">{{ model.draft_note|default('') }}</textarea></div>{% endif %}
            <div class="admin-settings-save"><button type="submit">Confirm decision</button><a href="{{ url(model.queue_url) }}">Cancel</a></div>
        </form>{% endif %}
    </section>{% endif %}
</div>
{% macro fields(model,r,p) %}
    {% include 'partials/csrf_field.twig' %}
    <input type="hidden" name="mod_request_token" value="{{ model.token }}">
    <input type="hidden" name="postid" value="{{ r ? r.postid : p.id }}">
    <input type="hidden" name="request_id" value="{{ r.id|default(0) }}">
{% endmacro %}
