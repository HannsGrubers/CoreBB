{% macro cleanup(user, token, action, label, question) %}
    <form method="post" action="{{ url('/admin/?act=user_pages&userid=' ~ user.id ~ '&section=profile') }}" data-confirm-submit="{{ question }}">
        {% include 'partials/csrf_field.twig' %}
        <input type="hidden" name="userid" value="{{ user.id }}">
        <input type="hidden" name="admin_user_pages_token" value="{{ token }}">
        <input type="hidden" name="action" value="{{ action }}">
        <button type="submit" class="admin-member-remove">{{ label }}</button>
    </form>
{% endmacro %}
{% set user = model.selected_user %}
<div class="admin-overview admin-settings admin-members">
    <header class="admin-dash-heading"><h1>User Pages</h1><a href="{{ url('/admin/') }}">Dashboard</a></header>
    <form class="admin-settings-form admin-member-search" action="{{ url('/admin/') }}" method="get">
        <input type="hidden" name="act" value="user_pages">
        <div class="admin-auth-field"><label for="member-lookup">Username or user ID</label>
            <input id="member-lookup" type="search" name="username" value="{{ model.search.username ?: model.search.userid }}" required autocomplete="off">
        </div>
        <div class="admin-settings-save"><button type="submit">Find member</button></div>
    </form>
    {% include 'partials/admin_messages.twig' with {messages:model.messages, errors:model.errors} only %}
    {% if user %}
    {% set record = '/admin/?act=user_pages&userid=' ~ user.id %}
    <section class="admin-member-head" aria-label="Selected member">
        <div><h2>{{ user.username }}</h2><p class="admin-history-count">#{{ user.id }} · {{ user.user_type }}{% if user.is_disabled == 'True' %} · Disabled{% endif %}{% if user.banned_raw %} · Banned{% endif %}</p></div>
        <div class="admin-member-links">
            <a href="{{ url(user.public_profile_url) }}">Public profile</a>
            <a href="{{ url('/private-messages/send/' ~ user.id ~ '/') }}">Send PM</a>
        </div>
    </section>
    <div class="member-workspace">
    <nav class="member-record-nav" aria-label="Member record">
        {% for key, label in model.sections %}<a href="{{ url(record ~ '&section=' ~ key) }}"{% if key == model.section %} aria-current="page"{% endif %}>{{ label }}</a>{% endfor %}
    </nav>
    <div class="member-record-content">
    {% if model.section == 'overview' %}
        <section aria-labelledby="member-account"><h2 id="member-account">Account overview</h2>
            <div class="member-overview-grid">
                <section class="member-overview-card"><header><h3>Role &amp; access</h3>{% if model.can_edit_rights %}<a href="{{ url('/admin/?act=edit_rights&user=' ~ user.id) }}">Edit rights</a>{% endif %}</header>
                    <p class="member-base-role">{{ user.moderator_role }}</p>
                    <h4>Direct grants</h4>
                    {% if user.special_access %}<ul class="member-grants">{% for tool in user.special_access %}<li>{{ tool.label }}</li>{% endfor %}</ul>
                    {% else %}<p class="admin-history-count">None</p>{% endif %}
                </section>
                <section class="member-overview-card"><header><h3>Account standing</h3></header>
                    <dl class="member-standing">
                        <dt>Status</dt><dd>{{ user.is_disabled == 'True' ? 'Disabled' : 'Enabled' }}</dd>
                        <dt>Ban</dt><dd>{{ user.banned_raw ? 'Banned' : 'No active ban' }}</dd>
                    </dl>
                    {% if model.can_moderate %}
                        {% if user.banned_raw %}<a href="{{ url('/admin/?act=moderation&mode=unban&username=' ~ user.username|url_encode) }}">Unban member</a>
                        {% else %}<a href="{{ url('/admin/?act=moderation&mode=ban&q=' ~ user.username|url_encode) }}">Ban member</a>{% endif %}
                    {% endif %}
                </section>
            </div>
            <h3 class="member-activity-title">Activity</h3>
            <dl class="admin-member-facts">
                <dt>Account added</dt><dd>{{ user.date_account_added|default('Unknown') }}</dd>
                <dt>Last login</dt><dd>{{ user.last_login_date|default('Unknown') }}</dd>
                <dt>Last post</dt><dd>{{ user.last_post_date|default('Unknown') }}</dd>
                {% if user.remote_user_id %}<dt>Remote user ID</dt><dd>{{ user.remote_user_id }}</dd>{% endif %}
                {% if user.last_ip %}<dt>Last IP address</dt><dd><a href="{{ url('/admin/?act=user_ip_check&ip=' ~ user.last_ip_display|url_encode) }}">{{ user.last_ip_display }}</a>
                    {% if model.can_host_lookup %}<a href="{{ url('/admin/?act=host_lookup&ip_address=' ~ user.last_ip_display|url_encode) }}">Host lookup</a>{% endif %}</dd>{% endif %}
            </dl>
            <dl class="admin-metrics"><div><dt>Actual posts</dt><dd>{{ user.actual_post_count|number_format }}</dd></div><div><dt>Virtual posts</dt><dd>{{ user.virtual_post_count|number_format }}</dd></div></dl>
        </section>
    {% elseif model.section == 'profile' %}
        <section><header class="admin-section-head"><h2>Profile content</h2><div class="admin-member-links">
            {% if user.can_edit_profile %}<a href="{{ url('/admin/?act=edit_profile&userid=' ~ user.id) }}">Edit profile</a>{% endif %}
            {% if user.can_edit_appearance %}<a href="{{ url(user.appearance_url) }}">Edit appearance</a>{% endif %}
        </div></header>
        <dl class="admin-member-facts">
            <dt>Title</dt><dd>
                {% if user.title|trim %}{% include 'partials/user_title.twig' with {title:user_title_model(user.title)} only %}{% else %}None{% endif %}
                {% if user.can_assign_title %}<div class="admin-member-links"><a href="{{ url('/admin/?act=assign_title&userid=' ~ user.id) }}">Assign title</a>
                    {% if user.title|trim %}{{ _self.cleanup(user,model.token,'clear_title','Clear title','Clear the title for ' ~ user.username ~ '?') }}{% endif %}</div>{% endif %}
            </dd>
            <dt>User icon</dt><dd>
                {% if user.icon.src %}<img class="admin-member-icon" src="{{ url(user.icon.src) }}" alt="{{ user.icon.filename|default('User icon') }}">
                {% elseif user.icon %}Icon #{{ user.icon.id }} is missing or unapproved.{% else %}None{% endif %}
                {% if user.icon and user.can_manage_icons %}<div class="admin-member-links"><a href="{{ url('/admin/?act=manage_icons&icon_id=' ~ user.icon.id) }}">Manage icon</a>
                    {{ _self.cleanup(user,model.token,'remove_icon','Remove icon','Remove the icon for ' ~ user.username ~ '?') }}</div>{% endif %}
            </dd>
            <dt>Signature</dt><dd>{% if user.signature|trim %}
                {% include 'partials/formatted_content.twig' with {content:admin_note_body_model(user.signature)} only %}
                {% if user.can_edit_profile %}{{ _self.cleanup(user,model.token,'clear_signature','Clear signature','Clear the signature for ' ~ user.username ~ '?') }}{% endif %}
            {% else %}None{% endif %}</dd>
        </dl></section>
    {% elseif model.section == 'posts' %}
        <section id="last_posts" class="admin-member-posts" aria-label="Last five visible posts">
        {% if model.recent_posts %}
            <div class="admin-member-post-head" aria-hidden="true"><span>Subject</span><span>Board</span><span>Posted</span></div>
            {% for post in model.recent_posts %}
            <details class="admin-member-post" name="member-recent-post">
                <summary>
                    <strong>{{ post.title|default('(no subject)') }}</strong>
                    <span>{{ post.board_name|default('Board #' ~ post.boardid) }}</span>
                    <span>{{ post.date_vn }}</span>
                </summary>
                <div class="admin-member-post-detail">
                    <div class="admin-member-body">{% include 'partials/formatted_content.twig' with {content:admin_note_body_model(post.body)} only %}</div>
                    <div class="admin-member-links">
                        <a href="{{ url(post.post_url) }}">Open in thread</a>
                        <a href="{{ url(post.board_url) }}">Open board</a>
                        {% if model.can_view_message %}<a href="{{ url(post.view_url) }}">View in admin</a>{% endif %}
                    </div>
                </div>
            </details>
            {% endfor %}
        {% else %}<p class="admin-history-count">No visible posts for this member.</p>{% endif %}
        </section>
    {% elseif model.section == 'notes' %}
        <section><header class="admin-section-head"><h2>Last five staff notes</h2><a href="{{ url('/admin/?act=admin_notes&userid=' ~ user.id) }}">Manage notes</a></header>
        <p class="admin-history-count">Private to authorized staff.</p>
        {% for note in model.recent_notes %}<article class="admin-member-entry">
            <h3>{{ note.reason|default('Misc') }}</h3><p class="admin-history-count">{% if note.author_id %}<a href="{{ url('/profile/' ~ note.author_id ~ '/') }}">{{ note.author_username|default('User ' ~ note.author_id) }}</a>{% else %}Unknown author{% endif %} · {{ note.date_vn|default(note.addtime) }}</p>
            <div class="admin-member-body">{% include 'partials/formatted_content.twig' with {content:admin_note_body_model(note.note)} only %}</div>
        </article>{% else %}<p>No staff notes for this member.</p>{% endfor %}
        </section>
    {% endif %}
    </div>
    </div>
    {% endif %}
</div>
