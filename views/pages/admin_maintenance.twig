{% set page = '/admin/?act=database_tools' %}
<div class="admin-overview admin-settings admin-database">
    <header class="admin-dash-heading">
        <h1>Database tools</h1>
        <a href="{{ url('/admin/') }}">Dashboard</a>
    </header>
    <nav class="admin-settings-nav" aria-label="Database tools">
        {% set tabs = {maintenance: 'Maintenance', backups: 'Backups'} %}
        {% if model.can_deploy %}{% set tabs = tabs|merge({schema: 'Schema deploy'}) %}{% endif %}
        {% for key, label in tabs %}
            <a href="{{ url(page ~ '&section=' ~ key) }}"{% if model.section == key %} aria-current="page"{% endif %}>{{ label }}</a>
        {% endfor %}
    </nav>
    {% if model.result %}
        <div class="admin-db-result{% if not model.result.ok %} is-error{% endif %}" role="status">
            <strong>{{ model.result.summary }}</strong>
            {% if model.result.details %}
            <details{% if not model.result.ok %} open{% endif %}>
                <summary>Operation details</summary>
                <ul>{% for line in model.result.details %}<li>{{ line }}</li>{% endfor %}</ul>
            </details>
            {% endif %}
        </div>
    {% endif %}
    {% if model.section == 'schema' %}
        {% if model.can_deploy %}
            {% include 'partials/admin_database_schema.twig' with {schema: model.schema, page: page} only %}
        {% endif %}
    {% elseif model.section == 'maintenance' %}
        {% for tool in [
            {title: 'Forum counts', description: 'Recalculate topic replies, board totals and member post counts from visible posts.',
             ready: model.cache_ready, state: model.cache_ready ? 'Cache enabled' : 'Cache off',
             date: model.cache_rebuilt_at, last: 'Last rebuilt', action: 'rebuild_counts', button: 'Rebuild counts'},
            {title: 'Search indexes', description: 'Check and create full-text indexes for topic titles, post titles and post content.',
             ready: model.search_ready, state: model.search_ready ? 'Full-text search ready' : 'Basic search',
             date: model.search_prepared_at, last: 'Last prepared', action: 'prepare_search_indexes', button: 'Prepare / repair indexes'}
        ] %}
        <section class="admin-db-tool" aria-labelledby="{{ tool.action }}-title">
            <div>
                <h2 id="{{ tool.action }}-title">{{ tool.title }}</h2>
                <p>{{ tool.description }}</p>
                <div class="admin-db-meta"><strong{% if tool.ready %} class="is-ready"{% endif %}>{{ tool.state }}</strong>
                    <span>{{ tool.last }} · {{ tool.date|default('No recorded run') }}</span>
                </div>
            </div>
            <form class="admin-settings-save" method="post" action="{{ url(page ~ '&section=maintenance') }}">
                {% include 'partials/csrf_field.twig' %}
                <input type="hidden" name="action" value="{{ tool.action }}">
                <button type="submit">{{ tool.button }}</button>
            </form>
        </section>
        {% endfor %}
    {% else %}
        <section class="admin-db-tool" aria-labelledby="backup-title">
            <div>
                <h2 id="backup-title">Database backup</h2>
                <p>Save the database structure and rows to a SQL file on the server. Large forums may take several minutes.</p>
                <details class="admin-db-location"><summary>Backup folder</summary><code>{{ model.backup_directory }}</code></details>
            </div>
            <form class="admin-settings-save" method="post" action="{{ url(page ~ '&section=backups') }}"
                  data-confirm-submit="Create a full database backup now?">
                {% include 'partials/csrf_field.twig' %}
                <input type="hidden" name="action" value="create_backup">
                <button type="submit">Create backup</button>
            </form>
        </section>
        <section class="admin-db-history" aria-labelledby="backup-history">
            <h2 id="backup-history">Recent backups</h2>
            {% if model.backup_recent %}
                <table><thead><tr><th scope="col">File</th><th scope="col">Size</th><th scope="col">Created</th></tr></thead>
                    <tbody>{% for backup in model.backup_recent %}
                        <tr><th scope="row">{{ backup.file }}</th><td>{{ backup.size }}</td><td>{{ backup.created }}</td></tr>
                    {% endfor %}</tbody>
                </table>
            {% else %}
                <p>No SQL backups found in the backup folder.</p>
            {% endif %}
        </section>
    {% endif %}
</div>
