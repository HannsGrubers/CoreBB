{% set page = '/admin/?act=updates' %}
{% set status = model.status %}
<div class="admin-overview admin-settings admin-updates">
    <header class="admin-dash-heading">
        <h1>Updates</h1>
        <div class="admin-updates-links"><a href="{{ url('/upgrade.php') }}">Recovery upgrader</a><a href="{{ url('/admin/') }}">Dashboard</a></div>
    </header>
    {% set banner = model.section == 'route' and status.state == 'current' ? status|merge({headline: 'Current on the stable channel.'}) : status %}
    {% include 'partials/admin_update_status.twig' with {update: banner, dashboard: false} only %}
    <nav class="update-sections" aria-label="Updates">
        {% for key, label in {releases: 'Releases', route: 'Plan upgrade', package: 'Package review'} %}
            <a href="{{ url(page ~ '&section=' ~ key) }}"{% if model.section == key %} aria-current="page"{% endif %}>
                <strong>{{ label }}</strong>
                <span>{% if key == 'releases' %}{{ model.releases|length }} recent {{ model.releases|length == 1 ? 'release' : 'releases' }}
                    {% elseif key == 'route' %}{% if model.route.active %}Destination · {{ model.route.target }}{% else %}Find a compatible path{% endif %}
                    {% else %}{{ model.package ? 'Validated · ' ~ model.package.version : 'No package staged' }}{% endif %}</span>
            </a>
        {% endfor %}
    </nav>
    {% include 'partials/admin_messages.twig' with {messages: model.messages, errors: model.errors} only %}
    {% if model.lock.exists %}
        <section class="admin-db-result is-error" aria-labelledby="update-lock">
            <h2 id="update-lock">{{ model.lock.stale ? 'Stale upgrade lock' : 'Upgrade lock in place' }}</h2>
            <p>Target {{ model.lock.target_version|default('Unknown') }} · Started {{ model.lock.created_label }} · Age {{ model.lock.age_label }}</p>
            <details><summary>Review lock and recovery options</summary>
                <p>Check that the upgrade has stopped before clearing its lock.</p>
                <dl class="admin-mail-envelope"><dt>Lock file</dt><dd>{{ model.lock.path }}</dd>
                    {% if model.lock.pid %}<dt>Process ID</dt><dd>{{ model.lock.pid }}</dd>{% endif %}
                </dl>
                {% if model.can_manage %}
                    <form class="admin-settings-form" method="post" action="{{ url(page ~ '&section=' ~ model.section) }}">
                        {% include 'partials/csrf_field.twig' %}<input type="hidden" name="action" value="clear_update_lock">
                        <label class="admin-auth-option"><input type="checkbox" name="clear_lock_confirmed" value="1" required> I have reviewed the interrupted upgrade and want to clear the lock.</label>
                        <label class="admin-auth-option"><input type="checkbox" name="disable_maintenance" value="1" checked> Also disable maintenance mode</label>
                        <div class="admin-settings-save"><button type="submit">Clear upgrade lock</button></div>
                    </form>
                {% endif %}
            </details>
        </section>
    {% endif %}
    <div class="update-workspace">
    {% if model.section == 'route' %}
        {% include 'partials/admin_update_route.twig' with {model: model, route: model.route, page: page} only %}
    {% elseif model.section == 'package' %}
        {% include 'partials/admin_update_package.twig' with {model: model, page: page} only %}
    {% else %}
        <section aria-labelledby="updates-catalog">
            <header class="admin-section-head">
                <div><h2 id="updates-catalog">Release catalog</h2>
                    <p class="admin-history-count">Last checked · {{ status.last_checked }}</p></div>
                {% if model.can_manage %}
                    <form class="admin-settings-save" method="post" action="{{ url(page ~ '&section=releases') }}">
                        {% include 'partials/csrf_field.twig' %}<input type="hidden" name="action" value="check_updates">
                        <button type="submit">Check for updates</button>
                    </form>
                {% endif %}
            </header>
            {% if status.recommended_next_version %}
                <p>Recommended next package · <strong>{{ status.recommended_next_version }}</strong>{% if not status.recommended_next_found %} (missing from the catalog){% endif %}</p>
            {% endif %}
            {% if model.releases %}
            <table class="update-catalog" aria-labelledby="updates-catalog">
                <thead><tr><th scope="col">Version</th><th scope="col">Channel</th><th scope="col">Released</th><th scope="col">Actions</th></tr></thead>
                <tbody>
                {% for release in model.releases %}
                <tr{% if release.version == status.installed_version %} class="is-installed"{% endif %}>
                    <th scope="row">{{ release.version }}
                        {% if release.version == status.installed_version %}<span class="update-release-tag">Installed</span>
                        {% elseif release.version == status.recommended_next_version %}<span class="update-release-tag">Recommended next</span>{% endif %}
                    </th>
                    <td>{{ release.type|capitalize }}</td><td>{{ release.date }}</td>
                    <td><div class="admin-updates-links">
                        {% if release.changelog_url starts with 'https://' %}<a href="{{ release.changelog_url }}">Changelog</a>{% endif %}
                        {% if release.download_url starts with 'https://' %}<a href="{{ release.download_url }}">Download</a>{% endif %}
                        {% if model.can_manage and not release.older_than_installed %}
                            <form class="admin-settings-save" method="post" action="{{ url(page ~ '&section=releases') }}">
                                {% include 'partials/csrf_field.twig' %}<input type="hidden" name="action" value="sideload_package">
                                <input type="hidden" name="release_version" value="{{ release.version }}">
                                <button type="submit" aria-label="Sideload {{ release.version }}"{% if not model.zip_available or not model.official_download_available or not (release.download_url starts with 'https://') or not (release.sha256 matches '/^[a-f0-9]{64}$/iD') %} disabled{% endif %}>Sideload</button>
                            </form>
                        {% endif %}
                    </div></td>
                </tr>
                {% endfor %}
                </tbody>
            </table>
            {% if model.can_manage %}<p class="admin-history-count">Sideload downloads and validates the official ZIP for review.</p>{% endif %}
            {% else %}<p>No releases are cached yet.</p>{% endif %}
            {% if not model.zip_available %}<p>PHP ZIP support is unavailable.</p>{% endif %}
            {% if not model.official_download_available %}<p>Outbound HTTPS downloads are unavailable.</p>{% endif %}
        </section>
        <details class="admin-update-disclosure"{% if status.check_warning or status.error %} open{% endif %}>
            <summary>Manifest and version details</summary>
            <dl class="admin-mail-envelope">
                {% for label, value in {'Manifest URL': model.manifest_url, 'Signature': status.signature_status, 'Last check result': status.check_status, 'Last successful check': status.last_successful_check, 'Manifest generated': status.manifest_generated_at, 'Installed version': status.installed_version, 'Installed schema': status.schema_version, 'Latest stable': status.latest_stable, 'Latest security': status.latest_security, 'Minimum safe version': status.minimum_safe_version} %}
                    <dt>{{ label }}</dt><dd>{{ value|default('Unknown') }}</dd>
                {% endfor %}
                {% if status.advisory.severity %}<dt>Advisory</dt><dd>{{ status.advisory.severity }} · {{ status.advisory.title }}</dd>{% endif %}
                {% if status.error %}<dt>Last error</dt><dd>{{ status.error }}</dd>{% endif %}
            </dl>
        </details>
    {% endif %}
    </div>
</div>
