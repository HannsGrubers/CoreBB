{% set base='/admin/?act=mod_requests' %}
<div class="admin-overview admin-settings reports-workspace">
    <header class="admin-dash-heading"><h1>Mod Post Requests</h1><a href="{{ url('/admin/') }}">Dashboard</a></header>
    {% include 'partials/admin_messages.twig' with {messages:model.messages|default([]),errors:model.errors|default([])} only %}
    {% if model.board_options is defined %}
    <nav class="appeal-tabs" aria-label="Report queues">
        <a href="{{ url(model.new_requests_url|default(base)) }}"{% if not model.old %} aria-current="page"{% endif %}>Open reports</a>
        <a href="{{ url(model.old_requests_url|default(base ~ '&old=yes')) }}"{% if model.old %} aria-current="page"{% endif %}>Handled reports</a>
    </nav>
    <form class="admin-settings-form report-filters" method="get" action="{{ url('/admin/') }}">
        <input type="hidden" name="act" value="mod_requests">{% if model.old %}<input type="hidden" name="old" value="yes">{% endif %}
        <div class="admin-auth-field"><label for="report-board">Board</label><select id="report-board" name="boardid">
            <option value="0">All visible boards</option>{% for board in model.board_options %}<option value="{{ board.id }}"{% if board.id==model.selected_board_id %} selected{% endif %}>{{ board.label }}</option>{% endfor %}
        </select></div>
        <div class="admin-auth-field"><label for="report-severity">Severity</label><select id="report-severity" name="severity"><option value="">Any severity</option>
            {% for value in 1..5 %}<option value="{{ value }}"{% if model.severity is not same as('') and model.severity == value %} selected{% endif %}>{{ value }}{{ value==1?' · Low':(value==3?' · Medium':(value==5?' · High':'')) }}</option>{% endfor %}
            {% if model.severity and model.severity not in 1..5 %}<option selected value="{{ model.severity }}">{{ model.severity }}</option>{% endif %}
        </select></div>
        <div class="admin-auth-field"><label for="report-url">Reported URL</label><input type="search" id="report-url" name="url" value="{{ model.url_filter }}" placeholder="All or part of the URL"></div>
        <div class="admin-settings-save"><button type="submit">Apply filters</button>{% if model.url_filter or model.severity or model.selected_board_id %}<a href="{{ url(base ~ (model.old ? '&old=yes' : '')) }}">Reset</a>{% endif %}</div>
    </form>
    {% if model.total is defined %}
    <section aria-label="{{ model.old ? 'Handled' : 'Open' }} reports">
        {% if model.requests %}<p class="admin-history-count">{{ (25*(model.page-1)+1)|number_format }}–{{ (25*(model.page-1)+model.requests|length)|number_format }} of {{ model.total|number_format }} · Highest severity first</p>
        <div class="report-columns" aria-hidden="true"><span>Reported message</span><span>Severity</span><span>{{ model.old ? 'Outcome' : 'Reported by' }}</span><span>Received</span></div>
        {% for report in model.requests %}<div class="report-row">
            <div><a class="report-subject" href="{{ url(report._moderate_url) }}">{{ report._post_title_label }}</a>
                <p>{{ report.board_name }} · {{ report._reason_label ?: 'No reason recorded' }}</p></div>
            <span class="report-severity" data-high="{{ report.severity >= 4 ? 'yes':'no' }}"><span class="report-mobile">Severity </span>{{ report.severity }}</span>
            <span><span class="report-mobile">{{ model.old ? 'Outcome · ' : 'By ' }}</span>{{ model.old ? report._status_label : report._reporter_label }}</span>
            <span class="report-date">{{ report.created_at ?: 'Not recorded' }}</span>
        </div>{% endfor %}
        {% else %}<p>No {{ model.old ? 'handled' : 'open' }} reports{{ model.selected_board_id or model.url_filter or model.severity ? ' match these filters.' : ' in this queue.' }}</p>{% endif %}
        {% set p=model.pagination %}
        {% if p.visible %}<nav class="admin-latest-pager" aria-label="Report pages">
            {% if p.prev.enabled %}<a rel="prev" href="{{ url(p.prev.url) }}">Previous</a>{% endif %}
            {% for item in p.items %}{% if item.type=='ellipsis' %}<span>…</span>{% elseif item.current %}<strong aria-current="page">{{ item.page }}</strong>{% else %}<a href="{{ url(item.url) }}" aria-label="Page {{ item.page }}">{{ item.page }}</a>{% endif %}{% endfor %}
            {% if p.next.enabled %}<a rel="next" href="{{ url(p.next.url) }}">Next</a>{% endif %}
        </nav>{% endif %}
    </section>{% endif %}{% endif %}
</div>
