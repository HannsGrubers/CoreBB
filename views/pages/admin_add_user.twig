{% set created = model.created_user %}
<div class="admin-overview admin-settings admin-add-user">
    <header class="admin-dash-heading"><h1>Add User</h1><a href="{{ url('/admin/') }}">Dashboard</a></header>
    {% include 'partials/admin_messages.twig' with {errors:model.errors} only %}
    {% if created %}
        <section class="admin-created-account" aria-labelledby="created-account">
            <div><h2 id="created-account">Account created</h2>
                <p><strong>{{ created.username }}</strong> · #{{ created.id }} · {{ created.role }}</p>
            </div>
            <div class="admin-member-links">
                {% if model.can_view_member %}<a href="{{ url('/admin/?act=user_pages&userid=' ~ created.id) }}">User Pages</a>{% endif %}
                {% if model.can_edit_rights and model.levels[created.accesslevel] is defined %}<a href="{{ url('/admin/?act=edit_rights&user=' ~ created.id) }}">Edit rights</a>{% endif %}
                <a href="{{ url('/profile/' ~ created.id ~ '/') }}">Public profile</a>
            </div>
        </section>
    {% endif %}
    {% if model.levels %}
    <form class="admin-settings-form admin-account-form" method="post" action="{{ url('/admin/?act=add_user') }}" autocomplete="off">
        {% include 'partials/csrf_field.twig' %}
        <fieldset class="admin-account-fields">
            <legend>Account details</legend>
            <div class="admin-auth-field admin-account-name">
                <label for="add-username">Username</label>
                <input id="add-username" name="username" value="{{ model.form.username }}" maxlength="255" required autocomplete="off" spellcheck="false">
            </div>
            <div class="admin-account-passwords">
                <div class="admin-auth-field"><label for="add-password">Password</label>
                    <input id="add-password" name="password1" type="password" autocomplete="new-password" required>
                </div>
                <div class="admin-auth-field"><label for="add-confirm-password">Confirm password</label>
                    <input id="add-confirm-password" name="password2" type="password" autocomplete="new-password" required>
                </div>
            </div>
        </fieldset>
        {% include 'partials/admin_role_choices.twig' with {levels:model.levels|reverse(true),role_details:model.role_details,selected_level:model.form.userlevel,marker_level:1,marker:'Default'} only %}
        <div class="admin-settings-save"><button type="submit">Create account</button></div>
    </form>
    {% endif %}
</div>
