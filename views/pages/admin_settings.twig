{% macro boolean(name, value, label) %}
    <div class="admin-setting-choice" role="group" aria-label="{{ label }}">
        {% if value is not same as('0') and value is not same as('1') %}
            <label><input type="radio" name="settings[{{ name }}]" value="{{ value }}" checked><span>Keep stored value</span></label>
        {% endif %}
        {% for choice, text in ['Disabled', 'Enabled'] %}
            <label><input type="radio" name="settings[{{ name }}]" value="{{ choice }}"{% if value is same as(choice ~ '') %} checked{% endif %}><span>{{ text }}</span></label>
        {% endfor %}
    </div>
{% endmacro %}
<div class="admin-overview admin-settings">
    <header class="admin-dash-heading">
        <h1>System settings</h1>
        <a href="{{ url('/admin/') }}">Dashboard</a>
    </header>
    <nav class="admin-settings-nav" aria-label="Settings sections">
        {% for key, title in model.sections %}
            <a href="{{ url('/admin/?act=edit_settings&section=' ~ key) }}"{% if key == model.section %} aria-current="page"{% endif %}>{{ title }}</a>
        {% endfor %}
    </nav>
    {% if model.message %}{% include 'partials/admin_messages.twig' with {messages: [model.message]} only %}{% endif %}
    {% include 'partials/admin_messages.twig' with {messages: model.messages, errors: model.errors} only %}
    <form class="admin-settings-form" name="systemsettings" method="post" action="{{ url('/admin/?act=edit_settings&section=' ~ model.section ~ '&method=post') }}">
        {% include 'partials/csrf_field.twig' %}
        <header class="admin-settings-heading"><h2>{{ model.sections[model.section] }}</h2>
            {% if model.section == 'limits' %}<p>Set the maximum number of actions allowed in each time window.</p>
            {% elseif model.section == 'maintenance' %}<p>Show this notice instead of the public forum while maintenance is enabled. Staff can still sign in and use Admin.</p>
            {% endif %}
            {% if model.upgrade_maintenance %}<p>Upgrade maintenance is active. The updater releases its hold after a successful upgrade.</p>{% endif %}
        </header>
        {% if model.section == 'limits' %}
            <div class="admin-limit-groups">
            {% for action, group in model.rate_groups %}
                {% set prefix = 'rate_limit_' ~ action ~ '_' %}
                <fieldset class="admin-limit-group">
                    <legend>{{ group.title }}</legend>
                    <div class="admin-limit-enable">
                        <span>{{ group.note }}</span>
                        {{ _self.boolean(prefix ~ 'enabled', model.settings[prefix ~ 'enabled'].value, group.title ~ ' rate limiting') }}
                    </div>
                    <div class="admin-limit-columns" aria-hidden="true"><span>Applies to</span><span>{{ group.unit }}</span><span>Window (seconds)</span></div>
                    {% for rule, scope in group.rules %}
                        {% set key = prefix ~ rule %}
                        <div class="admin-limit-rule">
                            <strong>{{ scope }}</strong>
                            <label><span>{{ group.unit }}</span><input type="number" min="1" max="100000" step="1" required aria-label="{{ group.title }} · {{ scope }} · {{ group.unit }}" name="settings[{{ key }}_max]" value="{{ model.settings[key ~ '_max'].value }}"></label>
                            <label><span>Window (seconds)</span><input type="number" min="1" max="604800" step="1" required aria-label="{{ group.title }} · {{ scope }} · Window in seconds" name="settings[{{ key }}_window]" value="{{ model.settings[key ~ '_window'].value }}"></label>
                        </div>
                    {% endfor %}
                </fieldset>
            {% endfor %}
            </div>
        {% else %}
            {% for name, field in model.fields %}
                {% set value = model.settings[name].value %}
                <div class="admin-setting-row{% if field[2] == 'textarea' %} is-editor{% endif %}">
                    <div class="admin-setting-label">
                        {% if field[2] == 'boolean' %}<strong>{{ field[0] }}</strong>{% else %}<label for="setting-{{ name }}">{{ field[0] }}</label>{% endif %}
                        {% if name == 'defaultstyle' %}<small>Used when a member follows the forum default.</small>
                        {% elseif name == 'showbasicstats' %}<small>Board and message counts, including posts today.</small>
                        {% elseif name == 'allowguests' %}<small>Disable to require sign-in before reading the forum. Private board permissions still apply.</small>
                        {% elseif name == 'customtitles' %}<small>Members can set a plain-text title in User CP → Edit Profile. Staff-assigned post titles take priority.</small>{% endif %}
                    </div>
                    {% if field[2] == 'style' %}
                        <select id="setting-{{ name }}" name="settings[{{ name }}]">
                            {% if value not in model.style_options|keys %}<option value="{{ value }}" selected>Current stylesheet · {{ value }}</option>{% endif %}
                            {% for file, label in model.style_options %}<option value="{{ file }}"{% if value == file %} selected{% endif %}>{{ label }}</option>{% endfor %}
                        </select>
                    {% elseif field[2] == 'boolean' %}
                        {{ _self.boolean(name, value, field[0]) }}
                    {% elseif field[2] == 'textarea' %}
                        <textarea id="setting-{{ name }}" name="settings[{{ name }}]" rows="{{ name == 'terms_of_service' ? 14 : 5 }}">{{ value }}</textarea>
                    {% else %}
                        <input id="setting-{{ name }}" type="text" name="settings[{{ name }}]" value="{{ value }}">
                    {% endif %}
                </div>
            {% endfor %}
        {% endif %}
        <div class="admin-settings-save"><button type="submit">Save {{ model.sections[model.section]|lower }}</button></div>
    </form>
</div>
