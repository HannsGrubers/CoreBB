{% set key = model.selected %}
{% set provider = model.providers[key] %}
{% set draft = model.draft %}
<div class="admin-overview admin-auth">
    <header class="admin-dash-heading">
        <div><h1>Authentication settings</h1>
            <p class="admin-history-count">{{ model.effective.enabled_count }} of {{ model.effective.provider_count }} sign-in providers active</p>
        </div>
        <a href="{{ url('/admin/') }}">Dashboard</a>
    </header>
    <nav class="admin-settings-nav admin-provider-nav" aria-label="Sign-in providers">
        {% for id, item in model.providers %}
            <a href="{{ url('/admin/?act=auth_settings&provider=' ~ id) }}"{% if id == key %} aria-current="page"{% endif %}>
                {{ item.label }} <small>{{ item.enabled ? (item.configured ? 'Active' : 'Needs setup') : 'Off' }}</small>
            </a>
        {% endfor %}
    </nav>
    {% include 'partials/admin_messages.twig' with {messages: model.messages, errors: model.errors} only %}

    <form class="admin-settings-form admin-provider-form" method="post" action="{{ url('/admin/?act=auth_settings&provider=' ~ key) }}">
        {% include 'partials/csrf_field.twig' %}
        <input type="hidden" name="action" value="save_auth">
        <header class="admin-settings-heading"><h2>{{ provider.label }} sign-in</h2></header>
        <label class="admin-auth-option">
            <input type="checkbox" name="authp[{{ key }}][en]" value="1"{% if draft.enabled %} checked{% endif %}>
            Enable {{ provider.label }} sign-in
        </label>
        <div class="admin-auth-field">
            <label for="auth-client-id">Client ID</label>
            <input id="auth-client-id" type="text" name="authp[{{ key }}][cid]" value="{{ draft.client_id }}" autocomplete="off" spellcheck="false" aria-describedby="auth-id-help">
            <small id="auth-id-help">Source: {{ provider.client_id_source }}. Leave blank to use private configuration.</small>
        </div>
        {% if provider.requires_client_secret %}
        <div class="admin-auth-field">
            <label for="auth-client-secret">Client secret</label>
            <input id="auth-client-secret" type="password" name="authp[{{ key }}][ckey]" autocomplete="new-password" aria-describedby="auth-secret-help">
            <small id="auth-secret-help">Source: {{ provider.secret_source }}. Leave blank to keep the current secret.</small>
        </div>
        {% endif %}
        {% if provider.supports_hosted_domain %}
        <div class="admin-auth-field">
            <label for="auth-domain">Google Workspace domain</label>
            <input id="auth-domain" type="text" name="authp[{{ key }}][hd]" value="{{ draft.hosted_domain }}" placeholder="example.com" autocomplete="off" spellcheck="false" aria-describedby="auth-domain-help">
            <small id="auth-domain-help">Optional. Restricts Google sign-in to accounts from this domain.</small>
        </div>
        {% endif %}
        {% if key == 'microsoft' %}
            <p class="admin-auth-policy">Members link Microsoft to an existing CoreBB account by confirming their forum password.</p>
        {% else %}
            <label class="admin-auth-option">
                <input type="checkbox" name="authp[{{ key }}][ac]" value="1"{% if draft.allow_auto_create %} checked{% endif %}>
                Allow verified {{ provider.label }} users to create a forum account
            </label>
        {% endif %}
        <div class="admin-settings-save"><button type="submit">Save {{ provider.label }} settings</button></div>
    </form>

    <section class="admin-provider-setup" aria-labelledby="provider-setup-title">
        <header class="admin-section-head"><h2 id="provider-setup-title">Provider setup</h2>
            <a href="{{ provider.setup_url }}" target="_blank" rel="noopener noreferrer">Open {{ provider.label }} setup</a>
        </header>
        <div class="admin-auth-field">
            <label for="auth-endpoint">{{ provider.uses_redirect_flow ? 'Callback URL' : 'Authorized JavaScript origin' }}</label>
            <input id="auth-endpoint" type="text" readonly value="{{ provider.uses_redirect_flow ? provider.redirect_url : provider.origin_url }}" data-forum-action="select">
        </div>
        <details><summary>Setup instructions and troubleshooting</summary>
            <ol>{% for step in provider.setup_steps %}<li>{{ step }}</li>{% endfor %}</ol>
            <ul>{% for note in provider.troubleshooting %}<li>{{ note }}</li>{% endfor %}</ul>
            <p>Scopes: <code>{{ provider.scope }}</code></p>
            {% if provider.alternate_redirect_url %}<p>Compatibility callback: <code>{{ provider.alternate_redirect_url }}</code></p>{% endif %}
            <a href="{{ provider.docs_url }}" target="_blank" rel="noopener noreferrer">Provider documentation</a>
            {% if provider.uses_redirect_flow and model.can_debug %} · <a href="{{ provider.debug_url }}">Debug sign-in URL</a>{% endif %}
        </details>
        {% if provider.uses_redirect_flow and provider.enabled and provider.configured %}<p><a href="{{ provider.start_url }}">Test {{ provider.label }} sign-in</a></p>{% endif %}
    </section>
</div>
