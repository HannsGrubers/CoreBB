{% set summary = model.summary %}
<div class="admin-overview board-directory-admin">
    <header class="admin-dash-heading">
        <div><h1>Manage Boards</h1>
            {% if summary %}<p class="admin-history-count">{{ summary.category_count|number_format }} {{ summary.category_count == 1 ? 'category' : 'categories' }} · {{ summary.board_count|number_format }} boards · {{ summary.topic_count|number_format }} topics · {{ summary.post_count|number_format }} posts</p>{% endif %}
        </div>
        <nav class="board-dir-links" aria-label="Board management">
            {% if model.can_view_stats %}<a href="{{ url('/admin/?act=forum_statistics') }}">Forum statistics</a>{% endif %}
            <a class="board-dir-add" href="{{ url('/admin/?act=add_category') }}">Add category</a>
        </nav>
    </header>
    {% include 'partials/admin_messages.twig' with {messages:model.messages|default([]),errors:model.errors|default([])} only %}
    {% for category in model.categories %}
    <section class="board-dir-group" aria-labelledby="category-name-{{ category.id }}">
        <header class="board-dir-row board-dir-category" id="category-{{ category.id }}" tabindex="-1">
            {{ _self.moves(category, 'category') }}
            <div class="board-dir-title">
                <h2 id="category-name-{{ category.id }}">{{ category.name }}</h2>
                <p>{{ category.board_count|number_format }} {{ category.board_count == 1 ? 'board' : 'boards' }}{% if category.private %} · Private category{% endif %}{% if category.secure_archive %} · Secure archive{% endif %}{% if category.default_open %} · Default open{% endif %}</p>
            </div>
            {{ _self.counts(category.topic_total, category.post_total) }}
            <div class="board-dir-links">
                {% if category.can_add_board %}<a class="board-dir-add" href="{{ url('/admin/?act=addboard&catid=' ~ category.id) }}">Add board</a>{% endif %}
                {% if not category.missing|default(false) %}
                    <a href="{{ url('/admin/?act=manageboards_cat&id=' ~ category.id) }}">{{ category.can_delete ? 'Edit category' : 'View category' }}</a>
                {% endif %}
                {% if category.can_delete %}<a class="board-dir-delete" href="{{ url('/admin/?act=delete_category&id=' ~ category.id) }}">Delete</a>{% endif %}
            </div>
        </header>
        <ol class="board-dir-list" aria-labelledby="category-name-{{ category.id }}">
            {% for board in category.boards %}
            <li class="board-dir-row board-dir-board" id="board-{{ board.id }}" tabindex="-1">
                {{ _self.moves(board, 'board') }}
                <div class="board-dir-title">
                    <h3><a href="{{ board.url }}">{{ board.name }}</a> <small>#{{ board.id }}</small></h3>
                    {% if board.description|trim %}<p>{{ board.description }}</p>{% endif %}
                    <div class="board-dir-meta">
                        {% if board.effective_secure_archive %}<span>Read-only archive</span>{% endif %}
                        {% if board.private %}<span>Private board</span>{% elseif board.effective_private %}<span>Private category</span>{% elseif not board.effective_secure_archive %}<span>Public</span>{% endif %}
                        {% if board.board_type == 'knowledge_base' %}<span>Knowledge Base</span>{% endif %}
                    </div>
                </div>
                {{ _self.counts(board.topiccount, board.postcount) }}
                <div class="board-dir-links">
                    <a href="{{ url('/admin/?act=modifyboard&id=' ~ board.id ~ '&method=edit') }}">{{ board.can_manage_access ? 'Edit details' : 'View details' }}</a>
                    {% if board.can_manage_access %}<a href="{{ url('/admin/?act=modifyboard&id=' ~ board.id ~ '&method=access') }}">Access</a>{% endif %}
                    {% if model.can_view_stats %}<a href="{{ url('/admin/?act=forum_statistics&boardid=' ~ board.id) }}">Stats</a>{% endif %}
                    {% if board.can_delete %}<a class="board-dir-delete" href="{{ url('/admin/?act=modifyboard&id=' ~ board.id ~ '&method=delete') }}">Delete</a>{% endif %}
                </div>
            </li>
            {% else %}<li class="board-dir-empty">No boards in this category.</li>{% endfor %}
        </ol>
    </section>
    {% else %}{% if not model.errors %}<p>No categories yet. Add a category to start organizing boards.</p>{% endif %}{% endfor %}
</div>

{% macro counts(topics, posts) %}
<div class="board-dir-counts"><span><strong>{{ topics|number_format }}</strong> {{ topics == 1 ? 'topic' : 'topics' }}</span><span><strong>{{ posts|number_format }}</strong> {{ posts == 1 ? 'post' : 'posts' }}</span></div>
{% endmacro %}
{% macro moves(item, kind) %}
<div class="board-dir-moves" role="group" aria-label="{{ kind|capitalize }} order for {{ item.name }}">
    {% for direction in ['up','down'] %}
        {% set label = 'Move ' ~ kind ~ ' ' ~ item.name ~ ' ' ~ direction %}
        {% if attribute(item, 'can_move_' ~ direction) %}
        <form method="post" action="{{ url('/admin/?act=' ~ (kind == 'category' ? 'movecat' : 'movebrd') ~ '&pos=' ~ direction ~ '&id=' ~ item.id) }}">
            {% include 'partials/csrf_field.twig' %}
            <input type="hidden" name="neighbor" value="{{ attribute(item, direction ~ '_id') }}">
            <button type="submit" title="{{ label }}" aria-label="{{ label }}">{{ direction == 'up' ? '↑' : '↓' }}</button>
        </form>
        {% else %}<button type="button" disabled aria-label="{{ label }}">{{ direction == 'up' ? '↑' : '↓' }}</button>{% endif %}
    {% endfor %}
</div>
{% endmacro %}
