{% set pm = model.detail|default(null) %}
<div class="admin-overview admin-settings admin-members appeals-workspace contact-inbox pm-history">
    <header class="admin-dash-heading">
        <h1>Private Message History</h1>
        {% if model.rows is defined %}<div class="admin-member-links">{% if model.can_view_reports %}<a href="{{ url('/admin/?act=pm_reports') }}">PM reports</a>{% endif %}<a href="{{ url('/admin/') }}">Dashboard</a></div>
        {% elseif model.queue_url %}<a href="{{ url(model.queue_url) }}">Back to results</a>{% endif %}
    </header>
    {% include 'partials/admin_messages.twig' with {messages:model.messages|default([]), errors:model.errors|default([])} only %}
    {% if model.rows is defined %}
        <form class="admin-settings-form pm-history-search" method="get" action="{{ url('/admin/') }}">
            <input type="hidden" name="act" value="pm_history">
            <div class="admin-auth-field"><label for="history-query">Search messages</label>
                <input type="search" name="q" id="history-query" value="{{ model.q }}" maxlength="255" placeholder="Name, message text, subject, or ID"></div>
            <div class="admin-auth-field"><label for="history-scope">Mailbox status</label>
                <select name="deleted" id="history-scope">
                    {% for key,caption in {'no':'In mailboxes','yes':'All messages','only':'Removed only'} %}<option value="{{ key }}"{% if model.scope == key %} selected{% endif %}>{{ caption }}</option>{% endfor %}
                </select></div>
            <div class="admin-settings-save"><button type="submit">Search</button>
                {% if model.q != '' or model.scope != 'no' %}<a href="{{ url('/admin/?act=pm_history') }}">Reset</a>{% endif %}</div>
        </form>
        {% if model.rows %}
            <p class="admin-history-count">{% if model.total == 1 %}1 message{% else %}{{ model.first|number_format }}–{{ model.last|number_format }} of {{ model.total|number_format }} · Newest first{% endif %}</p>
            <table class="contact-list">
                <thead><tr><th scope="col">Subject</th><th scope="col">From</th><th scope="col">To</th><th scope="col">Sent</th><th scope="col">Status</th></tr></thead>
                <tbody>{% for item in model.rows %}<tr>
                    <td><a class="report-subject" href="{{ url(model.detail_base ~ item.id) }}">{{ item.title ?: 'Untitled message' }}</a> <small>#{{ item.id }}</small></td>
                    <td><span class="contact-mobile-label">From </span>{{ item.sender_username ?: 'Member #' ~ item.senderid }}</td>
                    <td><span class="contact-mobile-label">To </span>{{ item.receiver_username ?: 'Member #' ~ item.recieveid }}</td>
                    <td>{{ item.datesent ?: 'Date unavailable' }}</td>
                    <td>{{ item.is_deleted ? 'Removed' : (item.markread ? 'Read' : 'Unread') }}</td>
                </tr>{% endfor %}</tbody>
            </table>
            {% include 'partials/admin_queue_pager.twig' with {pager:model.pagination, label:'Message history pages'} only %}
        {% else %}<p class="appeal-empty">No messages match these filters.</p>{% endif %}
    {% elseif pm %}
        <article class="admin-title-editor">
            <header class="admin-member-head"><div>
                <h2>{{ pm.title ?: 'Untitled message' }}</h2>
                <p class="admin-history-count">From {{ _self.member(pm.sender_username,pm.senderid,model.can_view_member) }} to {{ _self.member(pm.receiver_username,pm.recieveid,model.can_view_member) }}</p>
                <p class="admin-history-count">PM #{{ pm.id }}{% if pm.datesent %} · {{ pm.datesent }}{% endif %} · {{ pm.markread ? 'Read' : 'Unread' }}</p>
            </div></header>
            <div class="contact-message"><div class="contact-body">{{ pm.message }}</div></div>
            {% if pm.is_deleted %}
                <section class="contact-compose"><h3>Removed from mailboxes</h3>
                    {% if pm.deleted_by or pm.deleted_at %}<p class="admin-history-count">{{ pm.deleted_by_username ?: (pm.deleted_by ? 'Staff #' ~ pm.deleted_by : 'Staff member unavailable') }}{% if pm.deleted_at %} · {{ pm.deleted_at }}{% endif %}</p>{% endif %}
                    {% if pm.delete_reason %}<div class="contact-body">{{ pm.delete_reason }}</div>{% endif %}
                </section>
            {% endif %}
            {% if model.can_remove or model.can_restore %}
                <details class="admin-title-remove"{% if model.errors %} open{% endif %}>
                    <summary>{{ model.can_restore ? 'Restore to mailboxes' : 'Remove from mailboxes' }}</summary>
                    <form class="admin-settings-form" method="post" action="{{ url(model.action_url) }}">
                        {% include 'partials/csrf_field.twig' %}
                        <input type="hidden" name="pmid" value="{{ pm.id }}">
                        <input type="hidden" name="action" value="{{ model.can_restore ? 'restore_pm' : 'delete_pm' }}">
                        <p>{{ model.can_restore ? 'The sender and recipient will see this message again. Previously handled reports stay closed.' : 'This removes the message from both mailboxes and closes its open reports.' }}</p>
                        {% if model.can_remove %}<div class="admin-auth-field"><label for="history-reason">Removal reason (optional)</label>
                            <textarea name="delete_reason" id="history-reason" rows="3" maxlength="255">{{ model.draft_reason }}</textarea>
                        </div>{% endif %}
                        <div class="admin-settings-save"><button type="submit">{{ model.can_restore ? 'Restore message' : 'Remove message' }}</button></div>
                    </form>
                </details>
            {% elseif model.blocked %}<p class="contact-compose">{{ model.blocked }}</p>{% endif %}
        </article>
    {% endif %}
</div>
{% macro member(name,id,linked) %}
    {% if linked and name %}<a href="{{ url('/admin/?act=user_pages&userid=' ~ id) }}">{{ name }}</a>{% else %}{{ name ?: 'Member #' ~ id }}{% endif %}
{% endmacro %}
