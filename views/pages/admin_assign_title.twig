{% set page = '/admin/?act=assign_title' %}
{% set user = model.selected_user %}
<div class="admin-overview admin-settings admin-members admin-titles">
    <header class="admin-dash-heading"><h1>Assign Title</h1><a href="{{ url('/admin/') }}">Dashboard</a></header>
    <form class="admin-settings-form admin-member-search" method="get" action="{{ url('/admin/') }}">
        <input type="hidden" name="act" value="assign_title">
        <div class="admin-auth-field"><label for="title-lookup">Username or user ID</label>
            <input type="search" id="title-lookup" name="user" value="{{ model.search_value }}" autocomplete="off" spellcheck="false" required>
        </div>
        <div class="admin-settings-save"><button type="submit">Find member</button></div>
    </form>
    {% include 'partials/admin_messages.twig' with {messages:model.messages, errors:model.errors} only %}
    {% if user %}
    <section class="admin-title-editor" aria-labelledby="title-member">
        <header class="admin-member-head">
            <div><h2 id="title-member">{{ user.username }}</h2><p class="admin-history-count">#{{ user.id }} · {{ user.level_name }}</p></div>
            <div class="admin-member-links">
                {% if model.can_view_member %}<a href="{{ url('/admin/?act=user_pages&userid=' ~ user.id ~ '&section=profile') }}">User Pages</a>{% endif %}
                <a href="{{ url(user.profile_url) }}">Public profile</a>
            </div>
        </header>
        <div class="admin-title-workspace">
            {% if model.can_edit %}
            <form class="admin-settings-form" method="post" action="{{ url(page ~ '&userid=' ~ user.id) }}">
                {% include 'partials/csrf_field.twig' %}
                <input type="hidden" name="userid" value="{{ user.id }}">
                <input type="hidden" name="admin_assign_title_token" value="{{ model.token }}">
                <input type="hidden" name="title_revision" value="{{ model.revision }}">
                <div class="admin-auth-field"><label for="assigned-title">Staff-assigned title</label>
                    <textarea id="assigned-title" name="title" rows="3" aria-describedby="assigned-title-help">{{ model.form_title }}</textarea>
                    <small id="assigned-title-help">Up to 255 characters including board codes. HTML tags are stripped.</small>
                </div>
                <details class="admin-title-help"><summary>Formatting examples</summary>
                    <dl><dt>Bold</dt><dd><code>[b]Guide[/b]</code></dd>
                        <dt>Italic</dt><dd><code>[i]Contributor[/i]</code></dd>
                        <dt>Color</dt><dd><code>[color=blue]Community team[/color]</code></dd></dl>
                </details>
                <div class="admin-settings-save admin-title-actions">
                    <button name="action" value="save_title" type="submit">Save title</button>
                    <button name="action" value="preview_title" type="submit" class="title-secondary">Preview title</button>
                </div>
            </form>
            {% endif %}
            {% set assigned = model.previewing ? model.form_title : model.current_title %}
            <section class="admin-title-sample" aria-labelledby="title-sample-label">
                <h3 id="title-sample-label">{{ model.previewing ? 'Unsaved preview' : 'Current post byline' }}</h3>
                <div class="admin-title-byline">
                    <strong>{{ user.username }}</strong>
                    {% if assigned|trim != '' %}
                        <div>{% include 'partials/user_title.twig' with {title:user_title_model(assigned)} only %}</div>
                    {% elseif model.member_title|trim != '' %}
                        <div>{{ model.member_title }}</div>
                    {% endif %}
                </div>
                <p>{{ assigned|trim != '' ? 'Staff-assigned title' : (model.member_title|trim != '' ? 'Member title' : 'No title displayed') }}</p>
            </section>
        </div>
        {% if model.can_edit and model.current_title != '' %}
        <details class="admin-title-remove">
            <summary>Clear assigned title</summary>
            <p>Remove the staff-assigned title for {{ user.username }}?{% if model.member_title|trim != '' %} Their member title will appear on posts.{% endif %}</p>
            <form method="post" action="{{ url(page ~ '&userid=' ~ user.id) }}">
                {% include 'partials/csrf_field.twig' %}
                <input type="hidden" name="userid" value="{{ user.id }}">
                <input type="hidden" name="admin_assign_title_token" value="{{ model.token }}">
                <input type="hidden" name="title_revision" value="{{ model.revision }}">
                <button type="submit" class="admin-member-remove" name="action" value="clear_title">Confirm removal</button>
            </form>
        </details>
        {% endif %}
    </section>
    {% endif %}
</div>
