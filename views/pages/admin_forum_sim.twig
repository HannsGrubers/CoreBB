{% set page = '/admin/?act=forum_sim' %}
{% set settings = model.settings %}
<div class="admin-overview admin-settings admin-sim">
    <header class="admin-dash-heading">
        <h1>Forum Sim-Test</h1>
        <a href="{{ url('/admin/') }}">Dashboard</a>
    </header>
    <nav class="admin-settings-nav" aria-label="Forum Sim-Test">
        {% for key, label in {run:'Run simulation', cleanup:'Cleanup'} %}
        <a href="{{ url(page ~ '&section=' ~ key) }}"{% if model.section == key %} aria-current="page"{% endif %}>{{ label }}</a>
        {% endfor %}
    </nav>
    {% if model.messages %}
    <section class="admin-db-result" aria-label="Simulation result" role="status">
        <strong>{{ model.messages|first }}</strong>
        {% if model.messages|length > 1 %}<ul>{% for detail in model.messages|slice(1) %}<li>{{ detail }}</li>{% endfor %}</ul>{% endif %}
    </section>
    {% endif %}
    {% include 'partials/admin_messages.twig' with {errors:model.errors} only %}

    {% if model.section == 'cleanup' %}
    <section class="admin-sim-cleanup" aria-labelledby="sim-cleanup-title">
        <h2 id="sim-cleanup-title">Remove simulation data</h2>
        <p>Cleanup covers all simulator runs across the forum. Removing a simulation thread also removes its replies, poll, and votes, including later contributions from members.</p>
        {% if model.inventory %}
        <dl class="admin-metrics">
            <div><dt>Simulator accounts</dt><dd>{{ model.inventory.users|number_format }}</dd></div>
            <div><dt>Simulation threads</dt><dd>{{ model.inventory.topics|number_format }}</dd></div>
        </dl>
        {% if model.inventory.users or model.inventory.topics %}
        <form class="admin-settings-form" action="{{ url(page ~ '&section=cleanup') }}" method="post">
            {% include 'partials/csrf_field.twig' %}<input type="hidden" name="action" value="wipe_forum_sim">
            <div class="admin-auth-field"><label for="sim-wipe-confirm">Type <code>WIPE SIM</code> to confirm removal</label>
                <input id="sim-wipe-confirm" name="wipe_confirm" autocomplete="off" required>
            </div>
            <div class="admin-settings-save"><button type="submit">Remove simulation data</button></div>
        </form>
        {% else %}<p>No simulation data to remove.</p>{% endif %}
        {% endif %}
    </section>
    {% else %}
    <form id="sim-run" class="admin-settings-form admin-sim-run" action="{{ url(page ~ '&section=run') }}" method="post"
          data-max-posts="{{ model.max_posts }}" data-max-votes="{{ model.max_votes }}">
        {% include 'partials/csrf_field.twig' %}<input type="hidden" name="action" value="run_forum_sim">
        <h2>Simulation setup</h2>
        <div class="admin-auth-field admin-sim-board"><label for="sim-board">Target board</label>
            <select id="sim-board" name="target_board">
                <option value="0"{% if settings.target_board == 0 %} selected{% endif %}>All eligible boards ({{ model.eligible_boards|length }})</option>
                {% if settings.target_board and (settings.target_board < 0 or model.target_boards is empty) %}
                    <option value="{{ settings.target_board }}" selected>Selected board is unavailable</option>
                {% endif %}
                {% for board in model.eligible_boards %}
                    <option value="{{ board.id }}"{% if board.id == settings.target_board %} selected{% endif %}>{{ board.category_name }} / {{ board.name }}</option>
                {% endfor %}
            </select>
            <small>{{ model.eligible_boards ? 'Simulation targets public, non-archive boards. Generated members reply inside threads from this run.' : 'No public, non-archive boards are available.' }}</small>
        </div>
        <div class="admin-sim-groups">
            {% for group, fields in model.groups %}
            <fieldset><legend>{{ group }}</legend>
                {% for name, field in fields %}
                <label for="sim-{{ name }}">{{ field[0] }}
                    <input id="sim-{{ name }}" type="number" step="1" name="{{ name }}" min="{{ field[2] }}" max="{{ field[3] }}" value="{{ settings[name] }}" required>
                </label>
                {% endfor %}
            </fieldset>
            {% endfor %}
        </div>
        <section class="admin-sim-estimate" aria-labelledby="sim-estimate-title">
            <h2 id="sim-estimate-title">Estimated workload</h2>
            <p>Replies and votes are randomized. The totals below are upper bounds.</p>
            <dl class="admin-metrics" aria-live="polite">
                <div><dt>Accounts</dt><dd data-total="accounts">{{ (settings.users + settings.mods)|number_format }}</dd></div>
                <div><dt>Posts including replies</dt><dd data-total="posts">{{ model.planned_posts|number_format }}</dd></div>
                <div><dt>Polls</dt><dd data-total="polls">{{ model.planned_polls|number_format }}</dd></div>
                <div><dt>Votes</dt><dd data-total="votes">{{ model.planned_votes|number_format }}</dd></div>
            </dl>
            <p id="sim-budget">Per-run limits · {{ model.max_posts|number_format }} posts and {{ model.max_votes|number_format }} votes.</p>
        </section>
        <div class="admin-auth-field admin-sim-confirm"><label for="sim-confirm">Type <code>SIMULATE</code> to create these records</label>
            <input id="sim-confirm" name="confirm" autocomplete="off" required>
        </div>
        <div class="admin-settings-save"><button type="submit"{% if model.eligible_boards is empty %} disabled{% endif %}>Run simulation</button></div>
    </form>
    <script nonce="{{ csp_nonce() }}">
    (() => {
        const form = document.getElementById('sim-run');
        const totals = form.querySelectorAll('[data-total]');
        const budget = document.getElementById('sim-budget');
        const submit = form.querySelector('button[type=submit]');
        const noBoards = submit.disabled;
        const limits = budget.textContent;
        function updateEstimate() {
            const value = key => form.elements.namedItem(key).valueAsNumber;
            const accounts = value('users') + value('mods');
            const posts = value('topics') * (1 + value('replies'));
            const polls = value('poll_votes') === 0 ? 0 : Math.min(value('topics'), value('poll_topics'));
            const votes = polls * Math.min(accounts, value('poll_votes'));
            const valid = Array.from(form.querySelectorAll('[type=number]')).every(input => input.validity.valid);
            const estimates = { accounts, posts, polls, votes };
            for (const cell of totals) {
                cell.textContent = valid ? estimates[cell.dataset.total].toLocaleString() : '—';
            }
            const over = posts > Number(form.dataset.maxPosts) || votes > Number(form.dataset.maxVotes);
            budget.textContent = valid && over ? limits + ' Reduce the workload before running.' : limits;
            budget.classList.toggle('is-over', valid && over);
            submit.disabled = noBoards || (valid && over);
        }
        form.addEventListener('input', updateEstimate);
        updateEstimate();
    })();
    </script>
    {% endif %}
</div>
