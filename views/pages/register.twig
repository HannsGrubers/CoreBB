{% set hasGoogle = model.google.enabled|default(false) %}
{% set hasProviders = model.oauthProviders|default([]) is not empty %}
{% set hasExternal = hasGoogle or hasProviders %}

{% if model.success|default(false) %}
<div class="corebb-login-page wb-public-form-workspace">
    <div class="corebb-login-header">
        <div>
            <div class="corebb-login-eyebrow">Account Registration</div>
            <h2>Registration Almost Complete</h2>
        </div>
    </div>

    <div class="corebb-login-panel corebb-auth-single">
        <div class="corebb-login-section-head">
            <h3>Your account was created.</h3>
            <span>Please check your email and click the verification link before logging in.</span>
        </div>

        {% if model.mailWarning|default('') %}
            <div class="corebb-login-alert">
                <span class="ErrorFont">{{ model.mailWarning }}</span>
            </div>
        {% endif %}

        <div class="corebb-login-actions corebb-login-actions--start">
            <a class="corebb-login-create-button" href="{{ url('auth.php?action=login') }}">Continue to login</a>
        </div>
    </div>
</div>
{% else %}
<div class="corebb-login-page corebb-register-page wb-public-form-workspace">
    <div class="corebb-login-header">
        <div>
            <div class="corebb-login-eyebrow">Account Registration</div>
            <h2>Create a CoreBB Account</h2>
        </div>
    </div>

    {% if model.errors|default([]) is not empty %}
        <div class="corebb-login-alert">
            <span class="ErrorFont"><b>Registration could not be completed:</b></span><br>
            {% for error in model.errors %}
                <span class="ErrorFont">&bull; {{ error }}</span><br>
            {% endfor %}
        </div>
    {% endif %}

    <div class="corebb-login-grid">
        <form class="corebb-login-panel corebb-login-form" name="registration" method="post" action="{{ url('auth.php?action=register') }}">
            {% include 'partials/csrf_field.twig' %}

            <div class="corebb-login-section-head">
                <h3>New User Registration</h3>
                <span>Choose your public screen name, then confirm the forum terms below.</span>
            </div>

            <label class="corebb-login-field">
                <span>Desired screen name</span>
                <input class="formtext" name="username" type="text" id="username" maxlength="20" autocomplete="username" value="{{ model.old.username|default('') }}">
            </label>

            <label class="corebb-login-field">
                <span>Your email address</span>
                <input class="formtext" name="email" type="email" id="email" autocomplete="email" value="{{ model.old.email|default('') }}">
                <small>This will not be public.</small>
            </label>

            <label class="corebb-login-field">
                <span>Password</span>
                <input class="formtext" name="pass1" type="password" id="pass1" maxlength="72" autocomplete="new-password">
            </label>

            <label class="corebb-login-field">
                <span>Confirm Password</span>
                <input class="formtext" name="pass2" type="password" id="pass2" maxlength="72" autocomplete="new-password">
            </label>

            <div class="corebb-login-field">
                <span>Forum Terms of Service</span>
                <div tabindex="0" class="RegistrationTOSBlock corebb-register-tos">
                    {% include 'partials/formatted_content.twig' with {content: stored_page_body_model(model.tos|default({}))} only %}
                </div>
                <small>Scroll the Terms of Service box if you want to read the full text, then confirm below.</small>
            </div>

            <label class="corebb-login-check">
                <input type="checkbox" name="confirm_age_13" value="1">
                <span>I am at least 13 years old.</span>
            </label>

            <label class="corebb-login-check">
                <input type="checkbox" name="agree_tos" value="1">
                <span>Yes, I agree to the Terms of Service.</span>
            </label>

            <div style="display: none;">
                <label>Website <input type="text" name="website" value="" autocomplete="off"></label>
            </div>

            <div class="corebb-login-actions">
                <input class="formsubmit corebb-login-submit" type="submit" name="ok" value="Create Account">
                <input class="formsubmit corebb-login-submit corebb-login-submit--secondary" type="reset" name="Submit2" value="Reset">
            </div>
        </form>

        <aside class="corebb-login-panel corebb-login-side">
            <div class="corebb-login-section-head">
                <h3>Already Registered?</h3>
                <span>You must verify your email before your account can post, send private messages, or manage a profile.</span>
            </div>

            <a class="corebb-login-create-button" href="{{ url('auth.php?action=login') }}">Log in here</a>

            <div class="corebb-login-section-head">
                <h3>Need Help?</h3>
                <span>
                    Forgot an existing account? Use
                    <a class="BoardRowBLink" href="{{ url('auth.php?action=recover') }}">password recovery</a>
                    or request a new
                    <a class="BoardRowBLink" href="{{ url('auth.php?action=resend') }}">verification email</a>.
                </span>
            </div>

            {% if hasExternal %}
                <div class="corebb-login-divider"><span>Or register with</span></div>

                <div class="corebb-login-provider-stack">
                    {% if hasGoogle %}
                        <div class="corebb-provider-google-shell">
                            {% include 'partials/google_signin_button.twig' with {google: model.google, text: 'continue_with', width: 320} only %}
                        </div>
                    {% endif %}

                    {% if hasProviders %}
                        {% include 'partials/oauth_provider_buttons.twig' with {providers: model.oauthProviders} only %}
                    {% endif %}
                </div>
            {% endif %}
        </aside>
    </div>
</div>
{% endif %}
