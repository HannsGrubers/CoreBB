{% set page = '/admin/?act=edit_profile' %}
{% set user = model.user %}
<div class="admin-overview admin-settings admin-members admin-profile-editor">
    <header class="admin-dash-heading"><h1>Edit User’s Profile</h1><a href="{{ url('/admin/') }}">Dashboard</a></header>
    <form class="admin-settings-form admin-member-search" action="{{ url('/admin/') }}" method="get">
        <input type="hidden" name="act" value="edit_profile">
        <div class="admin-auth-field"><label for="profile-lookup">Username or user ID</label>
            <input id="profile-lookup" name="user" type="search" value="{{ model.search_value }}" spellcheck="false" autocomplete="off" required>
        </div>
        <div class="admin-settings-save"><button type="submit">Find member</button></div>
    </form>
    {% include 'partials/admin_messages.twig' with {messages:model.messages, errors:model.errors} only %}
    {% if user %}
    <header class="admin-member-head">
        <div><h2>{{ user.username }}</h2><p class="admin-history-count">#{{ user.id }} · {{ user.level_name }}</p></div>
        <div class="admin-member-links">
            {% if model.can_view_member %}<a href="{{ url('/admin/?act=user_pages&userid=' ~ user.id ~ '&section=profile') }}">User Pages</a>{% endif %}
            <a href="{{ url(user.profile_url) }}">Public profile</a>
        </div>
    </header>
    {% if model.sections %}
    {% set record = page ~ '&userid=' ~ user.id %}
    <div class="member-workspace">
        <nav class="member-record-nav" aria-label="Profile sections">
            {% for key,label in model.sections %}<a href="{{ url(record ~ '&section=' ~ key) }}"{% if model.section == key %} aria-current="page"{% endif %}>{{ label }}</a>{% endfor %}
        </nav>
        <section class="member-record-content" aria-labelledby="profile-section">
            <h2 id="profile-section">{{ model.sections[model.section] }}</h2>
            {% if model.profile is defined %}
            <form class="admin-settings-form" method="post" action="{{ url(record ~ '&section=' ~ model.section ~ '&method=save') }}">
                {% include 'partials/csrf_field.twig' %}
                <input type="hidden" name="userid" value="{{ user.id }}">
                <input type="hidden" name="admin_edit_profile_token" value="{{ model.token }}">
                <input type="hidden" name="revision" value="{{ model.revision }}">
                <div class="profile-edit-fields">
                {% for key,field in model.fields %}
                    <div class="admin-auth-field">
                        <label for="profile-{{ key }}">{{ key == 'birthday' ? 'Birthday' : field.label|trim(':') }}</label>
                        {% if key == 'bio' %}
                            <textarea id="profile-bio" name="bio" rows="8" aria-describedby="profile-bio-help">{{ model.profile.bio }}</textarea>
                            <small id="profile-bio-help">Board markup is supported. HTML tags are stripped when you save.</small>
                        {% else %}
                            <input id="profile-{{ key }}" name="{{ key }}" type="text" maxlength="{{ field.maxlength }}" value="{{ model.profile[key] }}"{% if key in ['websiteurl','profpic','pubemail'] %} spellcheck="false" inputmode="{{ key == 'pubemail' ? 'email' : 'url' }}"{% endif %}{% if key in ['birthday','pubemail'] %} aria-describedby="profile-{{ key }}-help"{% endif %}>
                            {% if key == 'birthday' %}<small id="profile-birthday-help">Shown on the public profile.</small>{% endif %}
                            {% if key == 'pubemail' %}<small id="profile-pubemail-help">Shown on the public profile. The recovery address is managed separately.</small>{% endif %}
                        {% endif %}
                    </div>
                {% endfor %}
                </div>
                <div class="admin-settings-save"><button type="submit">Save {{ model.sections[model.section]|lower }}</button></div>
            </form>
            {% endif %}
        </section>
    </div>
    {% endif %}
    {% endif %}
</div>
