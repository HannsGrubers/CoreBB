{% macro pager(model, position) %}
    {% if model.total_pages > 1 %}
        {% set base = '/admin/?act=latest_users&status=' ~ model.filter ~ '&page=' %}
        <nav class="admin-latest-pager" aria-label="Account pages, {{ position }}">
            {% if model.page > 1 %}<a rel="prev" href="{{ url(base ~ (model.page - 1)) }}">Previous</a>{% endif %}
            {% for number in model.page_numbers %}
                {% if number == '...' %}
                    <span aria-hidden="true">…</span>
                {% else %}
                    <a href="{{ url(base ~ number) }}" aria-label="Page {{ number }}"{% if number == model.page %} aria-current="page"{% endif %}>{{ number|number_format }}</a>
                {% endif %}
            {% endfor %}
            {% if model.page < model.total_pages %}<a rel="next" href="{{ url(base ~ (model.page + 1)) }}">Next</a>{% endif %}
        </nav>
    {% endif %}
{% endmacro %}
<div class="admin-overview admin-latest">
    <header class="admin-dash-heading">
        <h1>Latest Users</h1>
        <a href="{{ url('/admin/') }}">Dashboard</a>
    </header>
    <nav class="people-status-filters" aria-label="Filter accounts by status">
        {% for state,label in {all:'All accounts', active:'Active', pending:'Pending', banned:'Banned'} %}
            <a href="{{ url('/admin/?act=latest_users&status=' ~ state) }}"{% if state == model.filter %} aria-current="page"{% endif %}>
                <span>{{ label }}</span><strong>{{ model.counts[state]|number_format }}</strong>
            </a>
        {% endfor %}
    </nav>
    {% if model.users %}
    <section class="admin-latest-list" aria-label="Latest member accounts">
        <p class="people-list-range">{{ ((model.page - 1) * model.per_page + 1)|number_format }}–{{ min(model.page * model.per_page, model.total)|number_format }} of {{ model.total|number_format }} non-archive {{ model.total == 1 ? 'account' : 'accounts' }} · Newest first</p>
        {{ _self.pager(model, 'top') }}
        <div class="admin-latest-head" aria-hidden="true"><span>Member</span><span>Registered</span><span>Status</span></div>
        {% for user in model.users %}
        <details class="admin-latest-row" name="latest-member">
            <summary>
                <span class="admin-latest-name"><strong>{{ user.username }}</strong> <small>#{{ user.id }}</small></span>
                <span class="admin-latest-date"><span class="admin-latest-mobile-label">Registered </span>{{ user.registered_display|default('Unknown') }}</span>
                <span class="admin-latest-state" data-status="{{ user.status_text|lower }}">{{ user.status_text }}</span>
            </summary>
            <div class="admin-latest-detail">
                <dl>
                    <div><dt>Last login</dt><dd>{{ user.last_login_display|default('Unknown') }}</dd></div>
                    <div><dt>Posts</dt><dd>{{ user.posts|number_format }}</dd></div>
                    <div><dt>Level</dt><dd>{{ user.accesslevel }} · {{ user.level_name }}</dd></div>
                    {% if model.access.user_ip_check and user.last_ip %}
                        <div><dt>Last IP</dt><dd><a href="{{ url(user.ip_check_url) }}">{{ user.last_ip }}</a></dd></div>
                    {% endif %}
                </dl>
                <div class="admin-member-links">
                    {% if model.access.user_pages %}<a href="{{ url(user.user_pages_url) }}">User Pages</a>{% endif %}
                    <a href="{{ url(user.public_profile_url) }}">Public profile</a>
                    {% if model.access.admin_notes %}<a href="{{ url(user.admin_notes_url) }}">Staff notes</a>{% endif %}
                    <a href="{{ url('/private-messages/send/' ~ user.id ~ '/') }}">Send PM</a>
                    {% if user.moderation_url is defined %}<a href="{{ url(user.moderation_url) }}">{{ user.status_text == 'Banned' ? 'Unban member' : 'Ban member' }}</a>{% endif %}
                </div>
            </div>
        </details>
        {% endfor %}
        {{ _self.pager(model, 'bottom') }}
    </section>
    {% else %}<p>{% if model.filter == 'all' %}No non-archive accounts found.{% else %}No {{ model.filter }} accounts found. <a href="{{ url('/admin/?act=latest_users') }}">Show all accounts</a>{% endif %}</p>{% endif %}
</div>
