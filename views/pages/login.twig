{% set hasGoogle = model.google.enabled|default(false) %}
{% set hasProviders = model.oauthProviders|default([]) is not empty %}
{% set hasExternal = hasGoogle or hasProviders %}

<div class="corebb-login-page wb-public-form-workspace">
    <div class="corebb-login-header">
        <div>
            <div class="corebb-login-eyebrow">Account Access</div>
            <h2>Log In to CoreBB</h2>
        </div>
    </div>

    {% if model.error|default('') %}
        <div class="corebb-login-alert">
            <span class="ErrorFont">{{ model.error }}</span>
        </div>
    {% endif %}

    <div class="corebb-login-grid">
        <form class="corebb-login-panel corebb-login-form" name="form1" method="post" action="{{ url('auth.php?action=login_submit') }}">
            {% include 'partials/csrf_field.twig' %}

            <div class="corebb-login-section-head">
                <h3>Existing User Login</h3>
                <span>Use your forum account credentials.</span>
            </div>

            <label class="corebb-login-field">
                <span>User Name</span>
                <input class="formtext" autocomplete="username" type="text" name="username" maxlength="72" value="">
            </label>

            <label class="corebb-login-field">
                <span>Password</span>
                <input class="formtext" autocomplete="current-password" type="password" name="password" maxlength="72">
            </label>

            <div class="corebb-login-help-links">
                <a class="BoardRowBLink" href="{{ url('auth.php?action=recover') }}">Forgot password?</a>
                <a class="BoardRowBLink" href="{{ url('auth.php?action=resend') }}">Need a verification email?</a>
            </div>

            <label class="corebb-login-field">
                <span>Prompt for Password</span>
                <select name="expiry">
                    {% for seconds, label in model.expiryOptions|default([]) %}
                        <option value="{{ seconds }}"{% if seconds == model.defaultExpiry|default(28800) %} selected{% endif %}>{{ label }}</option>
                    {% endfor %}
                </select>
            </label>

            <div class="corebb-login-actions">
                <input class="formsubmit corebb-login-submit" type="submit" value="Log In" name="cmdSubmit" id="cmdSubmit">
            </div>
        </form>

        <aside class="corebb-login-panel corebb-login-side">
            <div class="corebb-login-section-head">
                <h3>New User?</h3>
                <span>Registration is quick, and verified accounts can post, send private messages, and manage their profile.</span>
            </div>

            <a class="corebb-login-create-button" href="{{ url('auth.php?action=register') }}" target="_top">Sign up now</a>

            {% if hasExternal %}
                <div class="corebb-login-divider"><span>Or continue with</span></div>

                <div class="corebb-login-provider-stack">
                    {% if hasGoogle %}
                        <div class="corebb-provider-google-shell">
                            {% include 'partials/google_signin_button.twig' with {google: model.google, text: 'continue_with', width: 320} only %}
                        </div>
                    {% endif %}

                    {% if hasProviders %}
                        {% include 'partials/oauth_provider_buttons.twig' with {providers: model.oauthProviders} only %}
                    {% endif %}
                </div>
            {% endif %}
        </aside>
    </div>

    <div class="corebb-login-footer">
        Having problems staying logged in? Read our
        <a class="BoardRowBLink" href="{{ url('support.php?action=faq') }}">Frequently Asked Questions</a> page.
        Also, <a class="BoardRowBLink" href="{{ url('auth.php?action=logout') }}"><strong>resetting/deleting</strong></a>
        your browser cookies may solve login issues.
    </div>
</div>
