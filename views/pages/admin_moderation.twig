{% set mode = model.mode|default('ban') %}
{% set token = model.token|default('') %}
{% set confirmUser = model.confirm_user|default(null) %}
{% if mode == 'ban' %}
{% set base = '/admin/?act=moderation&mode=ban' %}
{% set resultsUrl = base ~ (model.query ? '&q=' ~ model.query|url_encode : '') %}
<div class="admin-overview admin-settings admin-members ban-workspace">
    <header class="admin-dash-heading"><h1>Ban User</h1>
        <nav class="board-dir-links" aria-label="Moderation links">
            {% if model.can_unban %}<a href="{{ url('/admin/?act=moderation&mode=unban') }}">Unban User</a>{% endif %}
            {% if model.can_requests %}<a href="{{ url('/admin/?act=moderation&mode=requests') }}">Unban Requests</a>{% endif %}
            <a href="{{ url('/admin/') }}">Dashboard</a>
        </nav>
    </header>
    {% include 'partials/admin_messages.twig' with {messages:model.messages|default([]),errors:model.errors|default([])} only %}
    {% if confirmUser %}
    <section class="admin-title-editor" aria-labelledby="ban-review-heading">
        <header class="admin-member-head"><div><h2 id="ban-review-heading">Review ban for {{ confirmUser.username }}</h2>
            <p class="admin-history-count">#{{ confirmUser.id }} · {{ confirmUser.level_name }}</p></div>
            <a href="{{ url(confirmUser.profile_url) }}">Public profile</a>
        </header>
        <form class="admin-settings-form ban-confirm" method="post" action="{{ url(base ~ '&review=' ~ confirmUser.id) }}">
            {% include 'partials/csrf_field.twig' %}
            <input type="hidden" name="admin_moderation_token" value="{{ token }}">
            <input type="hidden" name="userid" value="{{ confirmUser.id }}">
            <input type="hidden" name="reviewed_level" value="{{ confirmUser.accesslevel }}">
            <input type="hidden" name="action" value="ban_save">
            <p class="ban-effect">This bans {{ confirmUser.username }}’s account.{% if confirmUser.accesslevel > 1 %} Their base role will change from <strong>{{ confirmUser.level_name }}</strong> to <strong>User</strong>.{% endif %}</p>
            <div class="admin-auth-field"><label for="ban-reason">Reason (optional)</label>
                <textarea id="ban-reason" name="reason" rows="4" aria-describedby="ban-reason-help"></textarea>
                <small id="ban-reason-help">The member can see this reason on their ban notice. It is also recorded in the admin action log.</small>
            </div>
            <div class="admin-settings-save"><button type="submit" class="ban-commit">Confirm ban</button> <a href="{{ url(resultsUrl) }}">Cancel</a></div>
        </form>
    </section>
    {% elseif model.token is defined %}
    <form class="admin-settings-form admin-member-search" method="get" action="{{ url('/admin/') }}">
        <input type="hidden" name="act" value="moderation"><input type="hidden" name="mode" value="ban">
        <div class="admin-auth-field"><label for="ban-search">Find an active member</label>
            <input type="search" id="ban-search" name="q" value="{{ model.query }}" placeholder="Username, user ID, email, or IP address" required autocomplete="off" spellcheck="false">
        </div>
        <div class="admin-settings-save"><button type="submit">Find member</button></div>
    </form>
    {% if model.results %}
    <section aria-labelledby="ban-matches"><header class="admin-section-head"><h2 id="ban-matches">Matching members</h2>
        <span class="admin-history-count">{{ model.results|length }} shown{% if model.results|length == model.result_limit %} · Refine your search for more specific matches{% endif %}</span></header>
        <ul class="ban-matches">
            {% for member in model.results %}
            <li><div><a class="ban-member-name" href="{{ member.profile_url }}">{{ member.username }}</a> <small>#{{ member.id }}</small>
                <p>{{ member.level_name }} · {{ member.posts|number_format }} {{ member.posts == 1 ? 'post' : 'posts' }}</p>
                {% if model.can_ip and member.last_ip %}<p>Last IP <a href="{{ url('/admin/?act=user_ip_check&userid=' ~ member.id) }}">{{ member.last_ip }}</a></p>{% endif %}
            </div>
            {% if member.blocked %}<span class="ban-protected">{{ member.blocked }}</span>
            {% else %}<a class="board-dir-add ban-review-link" href="{{ url(resultsUrl ~ '&review=' ~ member.id) }}">Review ban</a>{% endif %}</li>
            {% endfor %}
        </ul>
    </section>
    {% endif %}
    {% endif %}
</div>
{% elseif mode == 'unban' %}
{% set base = '/admin/?act=moderation&mode=unban' %}
<div class="admin-overview admin-settings admin-members unban-workspace">
    <header class="admin-dash-heading"><h1>Unban User</h1>
        <nav class="board-dir-links" aria-label="Moderation links">
            {% if model.can_ban %}<a href="{{ url('/admin/?act=moderation&mode=ban') }}">Ban User</a>{% endif %}
            {% if model.can_requests %}<a href="{{ url('/admin/?act=moderation&mode=requests') }}">Unban Requests</a>{% endif %}
            <a href="{{ url('/admin/') }}">Dashboard</a>
        </nav>
    </header>
    {% include 'partials/admin_messages.twig' with {messages:model.messages|default([]),errors:model.errors|default([])} only %}
    {% if confirmUser %}
        <section class="admin-title-editor" aria-labelledby="unban-heading">
            <header class="admin-member-head"><div><h2 id="unban-heading">Review ban for {{ confirmUser.username }}</h2>
                <p class="admin-history-count">#{{ confirmUser.id }} · {{ confirmUser.level_name }}</p></div>
                <a href="{{ confirmUser.profile_url }}">Public profile</a>
            </header>
            <div class="unban-record"><dl>
                <div><dt>Banned by</dt><dd>{{ confirmUser.staff_name ?: (confirmUser.banned_by ? 'User #' ~ confirmUser.banned_by : 'Not recorded') }}</dd></div>
                <div><dt>When</dt><dd>{{ confirmUser.banned_at ?: 'Not recorded' }}</dd></div>
                <div><dt>Ban reason</dt><dd>{{ confirmUser.ban_reason ?: 'No reason recorded' }}</dd></div>
            </dl></div>
            {% if confirmUser.blocked %}<div class="unban-decision"><p>{{ confirmUser.blocked }}</p><a href="{{ url(model.back_url) }}">Back to accounts</a></div>
            {% else %}
            <form class="admin-settings-form unban-decision" method="post" action="{{ url(model.back_url ~ '&review=' ~ confirmUser.id) }}">
                {% include 'partials/csrf_field.twig' %}
                <input type="hidden" name="action" value="unban_save">
                <input type="hidden" name="userid" value="{{ confirmUser.id }}">
                <input type="hidden" name="revision" value="{{ model.revision }}">
                <input type="hidden" name="admin_moderation_token" value="{{ token }}">
                <p>The account ban will be lifted. {{ confirmUser.username }} will keep the <strong>{{ confirmUser.level_name }}</strong> role.</p>
                <div class="admin-auth-field"><label for="unban-note">Staff note (optional)</label>
                    <textarea id="unban-note" name="note" rows="3" aria-describedby="unban-note-help"></textarea>
                    <small id="unban-note-help">Saved in the admin action log.</small></div>
                <div class="admin-settings-save"><button type="submit">Confirm unban</button><a href="{{ url(model.back_url) }}">Cancel</a></div>
            </form>{% endif %}
        </section>
    {% elseif model.back_url is defined %}
        <form class="admin-settings-form unban-filters" method="get" action="{{ url('/admin/') }}">
            <input type="hidden" name="act" value="moderation"><input type="hidden" name="mode" value="unban">
            <div class="admin-auth-field"><label for="unban-member">Member</label><input type="search" id="unban-member" name="username" value="{{ model.member_filter }}" placeholder="Username, user ID, or email" autocomplete="off"></div>
            <div class="admin-auth-field"><label for="unban-address">Last IP or stored host</label><input type="search" id="unban-address" name="ip_address" value="{{ model.address_filter }}" spellcheck="false" autocomplete="off"></div>
            <div class="admin-settings-save"><button type="submit">Find members</button>{% if model.member_filter or model.address_filter %}<a href="{{ url(base) }}">Reset</a>{% endif %}</div>
        </form>
        {% if model.total is defined %}
        <section aria-labelledby="banned-accounts"><header class="admin-section-head"><h2 id="banned-accounts">Banned accounts</h2>
            {% if model.total %}<span class="admin-history-count">{{ model.first|number_format }}–{{ model.last|number_format }} of {{ model.total|number_format }} · Newest bans first</span>{% endif %}</header>
            {% if model.results %}
            <div class="unban-list"><div class="unban-columns" aria-hidden="true"><span>Member</span><span>Banned by</span><span>When</span><span></span></div>
                {% for user in model.results %}
                <div class="unban-row"><div><a class="ban-member-name" href="{{ user.profile_url }}">{{ user.username }}</a> <small>#{{ user.id }}</small>
                    {% if model.can_ip and user.last_ip %}<p>Last IP <a href="{{ url('/admin/?act=user_ip_check&userid=' ~ user.id) }}">{{ user.last_ip }}</a></p>{% endif %}</div>
                    <div><span class="unban-mobile-label">Banned by </span>{{ user.staff_name ?: (user.banned_by ? 'User #' ~ user.banned_by : 'Not recorded') }}</div>
                    <div><span class="unban-mobile-label">When · </span>{{ user.banned_at ?: 'Not recorded' }}</div>
                    <a class="unban-review-link" href="{{ url(model.back_url ~ '&review=' ~ user.id) }}">Review ban</a>
                </div>{% endfor %}
            </div>
            {% if model.pagination.visible %}<nav class="admin-latest-pager" aria-label="Banned account pages">
                {% if model.pagination.prev.enabled %}<a rel="prev" href="{{ url(model.pagination.prev.url) }}">Previous</a>{% endif %}
                {% for item in model.pagination.items %}{% if item.type=='ellipsis' %}<span>…</span>{% elseif item.current %}<strong aria-current="page">{{ item.page }}</strong>{% else %}<a href="{{ url(item.url) }}" aria-label="Page {{ item.page }}">{{ item.page }}</a>{% endif %}{% endfor %}
                {% if model.pagination.next.enabled %}<a rel="next" href="{{ url(model.pagination.next.url) }}">Next</a>{% endif %}
            </nav>{% endif %}
            {% elseif model.member_filter or model.address_filter %}<p>No banned accounts match these filters. <a href="{{ url(base) }}">Show all banned accounts</a></p>
            {% else %}<p>No banned accounts.</p>{% endif %}
        </section>{% endif %}
    {% endif %}
</div>
{% else %}
{% set base = '/admin/?act=moderation&mode=requests' %}
{% set appeal = model.appeal|default(null) %}
<div class="admin-overview admin-settings admin-members appeals-workspace">
    <header class="admin-dash-heading"><h1>Unban Requests</h1>
        <nav class="board-dir-links" aria-label="Moderation links">
            {% if model.can_ban %}<a href="{{ url('/admin/?act=moderation&mode=ban') }}">Ban User</a>{% endif %}
            {% if model.can_unban %}<a href="{{ url('/admin/?act=moderation&mode=unban') }}">Unban User</a>{% endif %}
            <a href="{{ url('/admin/') }}">Dashboard</a>
        </nav>
    </header>
    {% include 'partials/admin_messages.twig' with {messages:model.messages|default([]),errors:model.errors|default([])} only %}
    {% if appeal %}
    <section class="admin-title-editor">
        <header class="admin-member-head"><div><h2>{{ appeal.username }}</h2><p class="admin-history-count">Request #{{ appeal.id }} · {{ appeal.status|capitalize }}</p></div>
            <a href="{{ url(model.queue_url) }}">Back to requests</a></header>
        <div class="appeal-reading">
            <section><h3>Member’s appeal</h3><p class="admin-history-count">Submitted {{ appeal.created ?: 'at an unknown time' }}</p>
                <blockquote>{{ appeal.text ?: 'No explanation recorded.' }}</blockquote>
                {% if appeal.status != 'pending' %}<h3>Staff response</h3>
                    <p class="admin-history-count">{{ appeal.reviewer ?: 'Staff member not recorded' }}{% if appeal.resolved %} · {{ appeal.resolved }}{% endif %}</p>
                    <p class="appeal-response">{{ appeal.response ?: 'No written response.' }}</p>
                {% endif %}
            </section>
            <section class="appeal-context"><h3>Account details</h3><dl>
                <dt>Member ID</dt><dd>{% if appeal.userid %}<a href="{{ url(appeal.member_url) }}">#{{ appeal.userid }}</a>{% else %}Unknown{% endif %}</dd>
                <dt>Verification</dt><dd>{{ appeal.verified }}</dd>
                {% if appeal.banned_by %}<dt>Last banned by</dt><dd>{{ appeal.banned_by }}</dd>{% endif %}
                {% if appeal.ban_date %}<dt>Ban date</dt><dd>{{ appeal.ban_date }}</dd>{% endif %}
                {% if appeal.ban_reason %}<dt>Ban reason</dt><dd>{{ appeal.ban_reason }}</dd>{% endif %}
                {% if appeal.ip %}<dt>IP address</dt><dd>{% if appeal.can_host %}<a href="{{ url('/admin/?act=host_lookup&ip_address=' ~ appeal.ip|url_encode) }}">{{ appeal.ip }}</a>{% else %}{{ appeal.ip }}{% endif %}</dd>{% endif %}
            </dl>{% if appeal.can_notes and appeal.userid %}<a href="{{ url('/admin/?act=admin_notes&userid=' ~ appeal.userid) }}">Staff notes</a>{% endif %}</section>
        </div>
        {% if appeal.status == 'pending' %}
        <form class="admin-settings-form appeal-decision" method="post" action="{{ url(model.queue_url ~ '&respond=' ~ appeal.id) }}">
            {% include 'partials/csrf_field.twig' %}
            <input type="hidden" name="request_id" value="{{ appeal.id }}"><input type="hidden" name="admin_moderation_token" value="{{ token }}">
            <input type="hidden" name="revision" value="{{ appeal.revision }}"><input type="hidden" name="ban_revision" value="{{ appeal.ban_revision }}">
            <fieldset><legend>Decision</legend><div class="appeal-options">
                <label><input name="action" type="radio" value="request_approve" required{% if not appeal.can_approve %} disabled{% endif %}><span><strong>Approve</strong><small>{{ appeal.can_approve ? 'Lift this member’s account ban.' : 'No active ban you can lift.' }}</small></span></label>
                <label><input name="action" type="radio" value="request_deny" required><span><strong>Deny</strong><small>Close the appeal and keep the current account status.</small></span></label>
            </div></fieldset>
            <div class="admin-auth-field"><label for="appeal-note">Response to member (optional)</label>
                <textarea id="appeal-note" name="admin_note" rows="3" aria-describedby="appeal-note-help">{{ model.draft_response|default('') }}</textarea>
                <small id="appeal-note-help">The member can read this in their request history.</small></div>
            <div class="admin-settings-save"><button type="submit">Confirm decision</button> <a href="{{ url(model.queue_url) }}">Cancel</a></div>
        </form>{% endif %}
    </section>
    {% elseif model.queue_url is defined and model.requests.pagination is defined %}
        {% set state = model.request_status %}
        <nav class="appeal-tabs" aria-label="Request queues">
            {% for key,label in {pending:'Pending',resolved:'Resolved',all:'All requests'} %}
                <a href="{{ url(base ~ '&status=' ~ key) }}"{% if state==key or (key=='resolved' and state in ['approved','denied']) %} aria-current="page"{% endif %}>{{ label }} <small>{{ model.request_counts[key]|number_format }}</small></a>
            {% endfor %}
        </nav>
        <section aria-labelledby="appeal-list-heading">
            <header class="admin-section-head"><h2 id="appeal-list-heading">{{ model.statuses[state] }} requests</h2>
            {% if state in ['resolved','approved','denied'] %}<nav class="board-dir-links" aria-label="Decision filter">
                {% for key,label in {resolved:'Both decisions',approved:'Approved',denied:'Denied'} %}<a href="{{ url(base ~ '&status=' ~ key) }}"{% if key==state %} aria-current="page"{% endif %}>{{ label }}</a>{% endfor %}
            </nav>{% endif %}</header>
            {% if model.requests.items %}<ul class="appeal-list">
                {% for req in model.requests.items %}<li><div><strong>{{ req.username ?: 'User #' ~ req.userid }}</strong> <small>#{{ req.id }}</small>
                    <p>Submitted {{ req.created_at ?: 'at an unknown time' }}</p></div>
                    {% if state != 'pending' %}<span>{{ req.status|capitalize }}</span>{% endif %}
                    <a class="unban-review-link" href="{{ url(model.queue_url ~ '&respond=' ~ req.id) }}">{{ req.status=='pending' ? 'Review request' : 'View decision' }}</a></li>{% endfor %}
            </ul>{% else %}<p class="appeal-empty">{{ state=='pending' ? 'No requests are waiting for a decision.' : 'No requests in this queue.' }}</p>{% endif %}
            {% set p=model.requests.pagination %}
            {% if p.visible %}<nav class="admin-latest-pager" aria-label="Request pages">
                {% if p.prev.enabled %}<a rel="prev" href="{{ url(p.prev.url) }}">Previous</a>{% endif %}
                {% for item in p.items %}{% if item.type=='ellipsis' %}<span>…</span>{% elseif item.current %}<strong aria-current="page">{{ item.page }}</strong>{% else %}<a href="{{ url(item.url) }}" aria-label="Page {{ item.page }}">{{ item.page }}</a>{% endif %}{% endfor %}
                {% if p.next.enabled %}<a rel="next" href="{{ url(p.next.url) }}">Next</a>{% endif %}
            </nav>{% endif %}
        </section>
    {% elseif model.queue_url is defined %}<a href="{{ url(model.queue_url) }}">Back to requests</a>{% endif %}
</div>
{% endif %}
