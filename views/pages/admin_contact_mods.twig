{% set detail = model.detail|default(null) %}
{% set base = '/admin/?act=contact_mods' %}
<div class="admin-overview admin-settings admin-members appeals-workspace contact-inbox">
    <header class="admin-dash-heading">
        <h1>Contact Mods Inbox</h1>
        {% if model.requests is defined %}<a href="{{ url('/admin/') }}">Dashboard</a>
        {% elseif model.queue_url %}<a href="{{ url(model.queue_url) }}">Back to {{ model.old ? 'handled requests' : 'open requests' }}</a>{% endif %}
    </header>
    {% include 'partials/admin_messages.twig' with {messages: model.messages|default([]), errors: model.errors|default([])} only %}
    {% if model.requests is defined %}
        <nav class="appeal-tabs" aria-label="Inbox queues">
            <a href="{{ url(base) }}"{% if not model.old %} aria-current="page"{% endif %}>Open requests</a>
            <a href="{{ url(base ~ '&old=yes') }}"{% if model.old %} aria-current="page"{% endif %}>Handled requests</a>
        </nav>
        {% if model.requests %}
            <p class="admin-history-count">{{ model.first|number_format }}–{{ model.last|number_format }} of {{ model.total|number_format }} · Newest first</p>
            <table class="contact-list">
                <thead><tr><th scope="col">Subject</th><th scope="col">From</th><th scope="col">Received</th>{% if model.old %}<th scope="col">Outcome</th>{% endif %}</tr></thead>
                <tbody>{% for item in model.requests %}
                    <tr>
                        <td><a class="report-subject" href="{{ url(item.detail_url) }}">{{ item.subject ?: 'Request #' ~ item.id }}</a>
                            {% if item.preview %}<span class="contact-preview">{{ item.preview }}</span>{% endif %}</td>
                        <td><span class="contact-mobile-label">From </span>{{ item.requester_username ?: 'Member #' ~ item.userid }}</td>
                        <td>{{ item.created_at ?: 'Date unavailable' }}</td>
                        {% if model.old %}<td>{{ item.status_label }}</td>{% endif %}
                    </tr>
                {% endfor %}</tbody>
            </table>
            {% include 'partials/admin_queue_pager.twig' with {pager:model.pagination, label:'Inbox pages'} only %}
        {% else %}<p class="appeal-empty">{{ model.old ? 'No handled requests yet.' : 'No open requests.' }}</p>{% endif %}
    {% elseif detail %}
        {% set sender = detail.requester_username ?: 'Member #' ~ detail.userid %}
        <article class="admin-title-editor">
            <header class="admin-member-head">
                <div><h2>{{ detail.subject ?: 'Untitled request' }}</h2>
                    <p class="admin-history-count">From {% if model.can_view_member %}<a href="{{ url('/admin/?act=user_pages&userid=' ~ detail.userid) }}">{{ sender }}</a>{% else %}{{ sender }}{% endif %}
                        {% if detail.created_at %} · {{ detail.created_at }}{% endif %} · Request #{{ detail.id }}</p>
                </div>
            </header>
            <div class="contact-message">
                <div class="contact-body">{{ detail.message }}</div>
                {% if model.submission_ip %}<details class="report-addresses"><summary>Submission IP</summary>
                    <a href="{{ url('/admin/?act=user_ip_check&ip=' ~ model.submission_ip|url_encode) }}">{{ model.submission_ip }}</a>
                </details>{% endif %}
            </div>
            {% if detail.status == 'new' %}
                {% if detail.requester_id %}
                    <form class="admin-settings-form contact-compose" method="post" action="{{ url(model.action_url) }}">
                        {{ _self.fields(model.token, detail.id, 'send_reply') }}
                        <div class="admin-auth-field"><label for="inbox-response">Reply to {{ sender }}</label>
                            <small id="inbox-delivery">The member will receive your reply by private message.</small>
                            <textarea id="inbox-response" name="response" rows="5" required maxlength="65535" aria-describedby="inbox-delivery">{{ model.draft_reply }}</textarea>
                        </div>
                        <div class="admin-settings-save"><button type="submit">Send reply and close</button></div>
                    </form>
                {% else %}<p class="contact-message">This account is unavailable for private messages.</p>{% endif %}
                <details class="admin-title-remove"{% if model.editing_note or not detail.requester_id %} open{% endif %}>
                    <summary>Close without a reply</summary>
                    <form class="admin-settings-form" method="post" action="{{ url(model.action_url) }}">
                        {{ _self.fields(model.token, detail.id, 'close_request') }}
                        <div class="admin-auth-field"><label for="inbox-note">Staff-only note (optional)</label>
                            <textarea id="inbox-note" name="handler_note" rows="3" maxlength="65535">{{ model.draft_note }}</textarea>
                        </div>
                        <div class="admin-settings-save"><button type="submit">Close request</button></div>
                    </form>
                </details>
            {% else %}
                <section class="contact-compose">
                    <h3>{{ detail.status == 'responded' ? 'Private reply sent' : (detail.status == 'ignored' ? 'Closed without a reply' : model.status_label) }}</h3>
                    <p class="admin-history-count">{{ detail.handler_username ?: (detail.handled_by ? 'Staff #' ~ detail.handled_by : 'Staff member unavailable') }}
                        {% if detail.handled_at %} · {{ detail.handled_at }}{% endif %}
                        {% if detail.response_pm_id %} · PM #{{ detail.response_pm_id }}{% endif %}</p>
                    {% if detail.handler_note %}{% if detail.status != 'responded' %}<h4>Staff-only note</h4>{% endif %}
                        <div class="contact-body">{{ detail.handler_note }}</div>{% endif %}
                    <form class="admin-settings-save" method="post" action="{{ url(model.action_url) }}">
                        {{ _self.fields(model.token, detail.id, 'reopen_request') }}<button type="submit">Reopen request</button>
                    </form>
                </section>
            {% endif %}
        </article>
    {% endif %}
</div>
{% macro fields(token, id, action) %}
    {% include 'partials/csrf_field.twig' %}
    <input type="hidden" name="contact_mods_token" value="{{ token }}">
    <input type="hidden" name="request_id" value="{{ id }}">
    <input type="hidden" name="action" value="{{ action }}">
{% endmacro %}
