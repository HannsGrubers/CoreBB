<div class="admin-overview">
    {% if model.message %}<p class="corebb-admin-modern-note">{{ model.message|replace({'+': ' '}) }}</p>{% endif %}
    <header class="admin-dash-heading">
        <h1>Dashboard</h1>
        {% if model.can_view_history %}<a href="{{ url('/admin/?act=version_history') }}">Version history</a>{% endif %}
    </header>

    {% if model.update_status %}
        {% include 'partials/admin_update_status.twig' with {update: model.update_status, dashboard: true} only %}
    {% endif %}

    <section aria-labelledby="snapshot-title">
        <h2 id="snapshot-title">Forum snapshot</h2>
        <dl class="admin-metrics">
            {% for label, value in model.stats %}<div><dt>{{ label }}</dt><dd>{{ value|number_format }}</dd></div>{% endfor %}
        </dl>
    </section>

    {% if model.activity_roles %}
    <section class="admin-activity" aria-labelledby="activity-title">
        <header class="admin-section-head">
            <h2 id="activity-title">Recent activity</h2>
            {% if model.activity_roles|length > 1 %}
            <label class="admin-role-filter" hidden>Role
                <select id="admin-activity-role"><option value="">All roles</option>
                    {% for level, name in model.activity_roles %}<option value="{{ level }}">{{ name }}</option>{% endfor %}
                </select>
            </label>
            {% endif %}
            {% if model.can_view_log %}<a href="{{ url('/admin/?act=action_log') }}">Full action log</a>{% endif %}
        </header>
        <table class="admin-activity-list" aria-labelledby="activity-title"{% if not model.activity %} hidden{% endif %}>
            <thead><tr><th scope="col">Action</th><th scope="col">Staff</th><th scope="col">When</th></tr></thead>
            <tbody>
            {% for row in model.activity %}
            <tr data-activity-level="{{ row.userlevel }}">
                <td class="admin-event"><strong>{{ row.action }}</strong>{% if row.detail %} <span class="admin-event-detail">{{ row.detail }}</span>{% endif %}</td>
                <td class="admin-event-staff">{% if model.can_view_log %}<a href="{{ row.admin_url }}">{{ row.admin_username }}</a>{% else %}{{ row.admin_username }}{% endif %} <span>· {{ model.activity_roles[row.userlevel] }}</span></td>
                <td class="admin-event-date">{{ row.date_vn }}</td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
        <p class="admin-activity-empty" role="status"{% if model.activity %} hidden{% endif %}>No recent actions to show.</p>
    </section>
    {% endif %}
    {% if model.show_staff %}
    <details class="admin-staff">
        <summary>Current administrators <span>({{ model.admins|length }})</span></summary>
        <ul>{% for admin in model.admins %}<li><a href="{{ url('/profile/' ~ admin.id ~ '/') }}">{{ admin.username }}</a></li>{% else %}<li>No administrator accounts were found.</li>{% endfor %}</ul>
    </details>
    {% endif %}
</div>
