{% set page = '/admin/?act=change_user_password' %}
{% set user = model.user %}
<div class="admin-overview admin-settings admin-members admin-password">
    <header class="admin-dash-heading"><h1>Change User’s Password</h1><a href="{{ url('/admin/') }}">Dashboard</a></header>
    <form class="admin-settings-form admin-member-search" method="get" action="{{ url('/admin/') }}">
        <input type="hidden" name="act" value="change_user_password">
        <div class="admin-auth-field"><label for="password-lookup">Username or user ID</label>
            <input id="password-lookup" name="user" type="search" value="{{ model.search_value }}" autocomplete="off" spellcheck="false" required>
        </div>
        <div class="admin-settings-save"><button type="submit">Find member</button></div>
    </form>
    {% include 'partials/admin_messages.twig' with {errors:model.errors} only %}
    {% if model.changed_user %}
        {% set member = model.changed_user %}
        <section class="admin-created-account" aria-labelledby="password-changed">
            <div><h2 id="password-changed">Password changed</h2><p><strong>{{ member.username }}</strong> · #{{ member.id }} · {{ member.level_name }}</p></div>
            <div class="admin-member-links">
                {% if model.can_view_member %}<a href="{{ url('/admin/?act=user_pages&userid=' ~ member.id) }}">User Pages</a>{% endif %}
                <a href="{{ url(member.profile_url) }}">Public profile</a>
            </div>
        </section>
    {% endif %}
    {% if user %}
    <section class="admin-password-editor" aria-labelledby="password-member-name">
    <header class="admin-member-head">
        <div><h2 id="password-member-name">{{ user.username }}</h2><p class="admin-history-count">#{{ user.id }} · {{ user.level_name }}</p></div>
        <div class="admin-member-links">
            {% if model.can_view_member %}<a href="{{ url('/admin/?act=user_pages&userid=' ~ user.id) }}">User Pages</a>{% endif %}
            <a href="{{ url(user.profile_url) }}">Public profile</a>
        </div>
    </header>
    <form class="admin-settings-form admin-password-form" method="post" action="{{ url(page ~ '&method=save&user=' ~ user.id) }}">
        {% include 'partials/csrf_field.twig' %}
        <input type="hidden" name="userid" value="{{ user.id }}">
        <fieldset class="admin-account-fields">
            <legend>Set a new password</legend>
            <p class="admin-history-count">Changing this password clears {{ user.username }}’s remembered sign-ins.</p>
            <div class="admin-account-passwords">
                <div class="admin-auth-field"><label for="member-new-password">New password</label>
                    <input id="member-new-password" name="password1" type="password" autocomplete="new-password" required>
                </div>
                <div class="admin-auth-field"><label for="member-confirm-password">Confirm new password</label>
                    <input id="member-confirm-password" name="password2" type="password" autocomplete="new-password" required>
                </div>
            </div>
        </fieldset>
        <div class="admin-settings-save"><button type="submit">Change password</button></div>
    </form>
    </section>
    {% endif %}
</div>
