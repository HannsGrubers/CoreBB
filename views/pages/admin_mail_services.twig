{% set v = model.values %}
{% set page = '/admin/?act=mail_services' %}
{% set transports = {mail: 'PHP mail', smtp: 'SMTP', disabled: 'Disabled'} %}
<div class="admin-overview admin-settings admin-mail">
    <header class="admin-dash-heading">
        <div><h1>Mail services</h1></div>
        <a href="{{ url('/admin/') }}">Dashboard</a>
    </header>
    <nav class="admin-settings-nav" aria-label="Mail services">
        <a href="{{ url(page) }}"{% if model.section == 'settings' %} aria-current="page"{% endif %}>Delivery settings</a>
        <a href="{{ url(page ~ '&section=test') }}"{% if model.section == 'test' %} aria-current="page"{% endif %}>Test delivery</a>
    </nav>
    {% include 'partials/admin_messages.twig' with {messages: model.messages, errors: model.errors} only %}

    {% if model.section == 'test' %}
    <form class="admin-settings-form" method="post" action="{{ url(page ~ '&section=test') }}">
        {% include 'partials/csrf_field.twig' %}
        <input type="hidden" name="action" value="send_test">
        <header class="admin-settings-heading"><h2>Test delivery</h2>
            <p>{% if model.delivery_disabled %}Outgoing mail is disabled. Enable delivery before sending a test.{% else %}Send one message using the saved {{ transports[v.transport] ?? v.transport }} settings.{% endif %}</p>
        </header>
        <dl class="admin-mail-envelope">
            <dt>Sender</dt><dd>{{ v.from_name }} &lt;{{ v.from_address }}&gt;</dd>
            {% if model.redirect_to %}<dt>Redirect all mail to</dt><dd>{{ model.redirect_to }}</dd>{% endif %}
            {% if model.debug_bcc %}<dt>Blind copy</dt><dd>{{ model.debug_bcc }}</dd>{% endif %}
        </dl>
        <div class="admin-auth-field"><label for="mail-test-recipient">Test recipient</label>
            <input id="mail-test-recipient" name="test_email" type="email" value="{{ model.test_email }}" required{% if model.redirect_to %} aria-describedby="mail-test-route"{% endif %}>
            {% if model.redirect_to %}<small id="mail-test-route">The redirect address above will receive this message.</small>{% endif %}
        </div>
        <div class="admin-settings-save"><button type="submit"{% if model.delivery_disabled %} disabled{% endif %}>Send test email</button></div>
    </form>
    {% else %}
    <form class="admin-settings-form" method="post" action="{{ url(page) }}">
        {% include 'partials/csrf_field.twig' %}
        <input type="hidden" name="action" value="save_mail">
        <header class="admin-settings-heading"><h2>Outgoing mail</h2>
            {% if model.delivery_suppressed %}<p>The host configuration disables outgoing mail for all delivery methods.</p>{% endif %}
            {% if not model.config_writable %}<p>The private configuration is read-only. Saving is unavailable.</p>{% endif %}
        </header>
        <div class="admin-auth-field"><label for="mail-transport">Delivery method</label>
            <select id="mail-transport" name="transport">
                {% for id, label in transports %}<option value="{{ id }}"{% if v.transport == id or (id == 'disabled' and v.transport in ['none','null','off']) %} selected{% endif %}>{{ label }}</option>{% endfor %}
            </select>
        </div>
        <div class="admin-mail-pair">
            <div class="admin-auth-field"><label for="mail-name">Sender name</label><input id="mail-name" name="from_name" value="{{ v.from_name }}" required></div>
            <div class="admin-auth-field"><label for="mail-address">Sender email</label><input id="mail-address" name="from_address" type="email" value="{{ v.from_address }}" required></div>
        </div>
        <div class="admin-auth-field"><label for="mail-redirect">Redirect all mail to</label>
            <input id="mail-redirect" name="redirect_to" type="email" value="{{ v.redirect_to }}" aria-describedby="mail-redirect-help">
            <small id="mail-redirect-help">For staging or testing. Leave blank to deliver to each intended recipient.</small>
        </div>

        <details id="mail-smtp" class="admin-mail-disclosure"{% if v.transport == 'smtp' or model.errors %} open{% endif %}>
            <summary>SMTP connection</summary>
            <div class="admin-mail-pair">
                <div class="admin-auth-field"><label for="smtp-host">Host</label><input id="smtp-host" name="smtp_host" value="{{ v.smtp_host }}" spellcheck="false"></div>
                <div class="admin-auth-field"><label for="smtp-port">Port</label><input id="smtp-port" name="smtp_port" type="number" min="1" max="65535" value="{{ v.smtp_port }}"></div>
            </div>
            <div class="admin-auth-field"><label for="smtp-secure">Connection security</label>
                <select id="smtp-secure" name="smtp_secure">
                    {% for id, label in {tls:'STARTTLS', ssl:'Implicit TLS', plain:'Plain (unencrypted)'} %}<option value="{{ id }}"{% if v.smtp_secure == id %} selected{% endif %}>{{ label }}</option>{% endfor %}
                </select>
            </div>
            <div class="admin-mail-pair">
                <div class="admin-auth-field"><label for="smtp-user">Username</label><input id="smtp-user" name="smtp_username" value="{{ v.smtp_username }}" autocomplete="off" spellcheck="false"></div>
                <div class="admin-auth-field"><label for="smtp-password">Password</label>
                    <input id="smtp-password" name="smtp_password" type="password" autocomplete="new-password" aria-describedby="smtp-password-help">
                    <small id="smtp-password-help">{{ model.password_configured ? 'Leave blank to keep the current password.' : 'Required to send using SMTP.' }}</small>
                </div>
            </div>
            <label class="admin-auth-option"><input type="checkbox" name="clear_smtp_password" value="1"> Clear the saved SMTP password</label>
            <div class="admin-mail-pair">
                <div class="admin-auth-field"><label for="smtp-helo">HELO hostname</label><input id="smtp-helo" name="smtp_helo" value="{{ v.smtp_helo }}" spellcheck="false"></div>
                <div class="admin-auth-field"><label for="smtp-timeout">Timeout (seconds)</label><input id="smtp-timeout" name="smtp_timeout" type="number" min="1" max="120" value="{{ v.smtp_timeout }}"></div>
            </div>
            <fieldset class="admin-mail-checks"><legend>Certificate checks</legend>
                {% for key, label in {smtp_verify_peer:'Verify server certificate', smtp_verify_peer_name:'Verify server hostname', smtp_allow_self_signed:'Allow self-signed certificates'} %}
                <label class="admin-auth-option"><input type="checkbox" name="{{ key }}" value="1"{% if v[key] %} checked{% endif %}> {{ label }}</label>
                {% endfor %}
            </fieldset>
        </details>
        <details class="admin-mail-disclosure"{% if model.errors %} open{% endif %}>
            <summary>Diagnostics</summary>
            <label class="admin-auth-option"><input type="checkbox" name="debug" value="1"{% if v.debug %} checked{% endif %}> Write sanitized mail diagnostics</label>
            <div class="admin-auth-field"><label for="mail-log">Log file path</label><input id="mail-log" name="debug_log" value="{{ v.debug_log }}" spellcheck="false"></div>
            <div class="admin-auth-field"><label for="mail-bcc">Blind copy address</label>
                <input id="mail-bcc" name="debug_bcc" type="email" value="{{ v.debug_bcc }}" aria-describedby="mail-bcc-help">
                <small id="mail-bcc-help">Receives a copy of outgoing mail even when diagnostic logging is off.</small>
            </div>
        </details>
        <div class="admin-settings-save"><button type="submit"{% if not model.config_writable %} disabled{% endif %}>Save mail settings</button></div>
    </form>
    <script nonce="{{ csp_nonce() }}">
        const mailTransport = document.getElementById('mail-transport');
        mailTransport.addEventListener('change', () => {
            if (mailTransport.value === 'smtp') document.getElementById('mail-smtp').open = true;
        });
        mailTransport.form.addEventListener('invalid', event => {
            const section = event.target.closest('details');
            if (section) section.open = true;
        }, true);
    </script>
    {% endif %}
</div>
