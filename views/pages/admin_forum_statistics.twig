{% set base = '/admin/?act=forum_statistics' %}
{% set totals = model.summary|default(null) %}
<div class="admin-overview admin-settings stats-report">
    <header class="admin-dash-heading">
        <div><h1>Forum Statistics</h1>
            {% if totals %}<p class="admin-history-count">{{ model.scope }} · {{ model.range }}</p>{% endif %}
        </div>
        <nav class="board-dir-links" aria-label="Forum statistics links">
            {% if model.boardid and model.board_rows|length %}<a href="{{ model.board_rows[0].public_url }}">Open board</a>{% endif %}
            {% if model.can_manage_boards %}<a href="{{ url('/admin/?act=manageboards') }}">Manage Boards</a>{% endif %}
            <a href="{{ url('/admin/') }}">Dashboard</a>
        </nav>
    </header>

    {% if model.board_options is defined %}
    <form class="admin-settings-form stats-filters" method="get" action="{{ url('/admin/') }}">
        <input type="hidden" name="act" value="forum_statistics">
        <div class="admin-auth-field"><label for="stats-board">Board</label><select id="stats-board" name="boardid">
            <option value="0">All boards</option>
            {% for board in model.board_options %}<option value="{{ board.id }}"{% if board.id == model.boardid %} selected{% endif %}>{{ board.category_name ? board.category_name ~ ' / ' : '' }}{{ board.name }}</option>{% endfor %}
        </select></div>
        <div class="admin-auth-field"><label for="stats-days">Date range</label><select id="stats-days" name="days">
            {% for days in model.day_options %}<option value="{{ days }}"{% if days == model.days %} selected{% endif %}>Last {{ days }} days</option>{% endfor %}
        </select></div>
        <div class="admin-settings-save"><button type="submit">Apply filters</button>
            {% if model.boardid or model.days != 30 %}<a href="{{ url(base) }}">Reset</a>{% endif %}
        </div>
    </form>
    {% endif %}
    {% if model.errors %}{% include 'partials/admin_messages.twig' with {errors:model.errors,messages:[]} only %}{% endif %}
    {% if totals %}
    <section class="stats-summary" aria-label="Report totals">
        <div><h2>Activity in the last {{ model.days }} days</h2><dl class="admin-metrics">
            <div><dt>Visits</dt><dd>{{ totals.visits|number_format }}</dd></div>
            <div><dt>Engagements</dt><dd>{{ totals.engagements|number_format }}</dd></div>
        </dl></div>
        <div><h2>Current content</h2><dl class="admin-metrics">
            <div><dt>Topics</dt><dd>{{ totals.topics|number_format }}</dd></div>
            <div><dt>Posts</dt><dd>{{ totals.posts|number_format }}</dd></div>
        </dl></div>
    </section>
    <div class="stats-charts">
        <section class="stats-panel"><h2>Daily activity</h2>
            {% if model.metric_chart.total %}
                {% set c = model.trend_chart %}
                <div class="stats-legend"><span>Visits</span><span>Engagements</span></div>
                <div class="stats-plot"><div class="stats-scale" aria-hidden="true"><span>{{ c.max_value|number_format }}</span><span>{{ c.half_value|number_format }}</span><span>0</span></div>
                <svg class="stats-trend" viewBox="{{ c.plot_left }} {{ c.plot_top }} {{ c.plot_right - c.plot_left }} {{ c.plot_bottom - c.plot_top }}" preserveAspectRatio="none" role="img" aria-label="Daily visits and engagements for {{ model.scope }}. Exact figures are in Daily totals.">
                    {% for y in [c.plot_top,(c.plot_top+c.plot_bottom)/2,c.plot_bottom] %}
                        <line x1="{{ c.plot_left }}" x2="{{ c.plot_right }}" y1="{{ y }}" y2="{{ y }}"/>
                    {% endfor %}
                    <path class="stats-fill" d="{{ c.visits_area }}"/>
                    <polyline class="stats-visits" points="{{ c.visits_points }}"/>
                    <polyline class="stats-engagements" points="{{ c.engagements_points }}"/>
                </svg>
                <div class="stats-dates" aria-hidden="true">{% for tick in c.labels %}<span>{{ tick.label }}</span>{% endfor %}</div></div>
            {% else %}<p class="stats-empty">No visits or engagements were recorded in this date range.</p>{% endif %}
        </section>
        <section class="stats-panel"><h2>Activity breakdown</h2>
            <dl class="stats-mix">
                {% for segment in model.metric_chart.segments %}
                <div><dt>{{ segment.label }}</dt><dd><span class="stats-rail" aria-hidden="true"><i style="width:{{ segment.percent }}%"></i></span>{{ segment.value|number_format }}</dd></div>
                {% endfor %}
            </dl>
        </section>
    </div>
    {% if not model.boardid %}
    <section class="stats-panel"><h2>Most active boards</h2>
        {% if model.top_board_rows %}
        <p class="admin-history-count">Ranked by visits and engagements combined.</p>
        <ol class="stats-ranking">
        {% for row in model.top_board_rows %}<li><a href="{{ url(row.url) }}">{{ row.name }}</a>
            <span>{{ row.visits|number_format }} {{ row.visits == 1 ? 'visit' : 'visits' }}</span>
            <span>{{ row.engagements|number_format }} {{ row.engagements == 1 ? 'engagement' : 'engagements' }}</span>
        </li>{% endfor %}
        </ol>{% else %}<p class="stats-empty">No boards recorded activity in this date range.</p>{% endif %}
    </section>
    {% endif %}
    <div class="stats-details">
        <details><summary>Daily totals <small>{{ model.days }} days</small></summary>
            <div class="stats-scroll" role="region" aria-label="Daily totals, newest first" tabindex="0">
            <table><caption>Daily totals, newest first</caption><thead><tr>
                {% for label in ['Date','Visits','Board visits','Topic views','New topics','Replies','Poll votes','Favorites added','Engagements'] %}<th scope="col">{{ label }}</th>{% endfor %}
            </tr></thead><tbody>
            {% for day in model.daily_rows|reverse %}<tr><th scope="row">{{ day.date }}</th>
                {% for key in ['visits','board_visits','topic_views','topics','replies','poll_votes','favorites_added','engagements'] %}<td>{{ day[key]|number_format }}</td>{% endfor %}
            </tr>{% endfor %}
            </tbody></table></div>
        </details>
        <details><summary>Board totals <small>{{ model.board_rows|length }} {{ model.board_rows|length == 1 ? 'board' : 'boards' }}</small></summary>
            {% if model.board_rows %}<div class="stats-scroll" role="region" aria-label="Board totals" tabindex="0">
            <table><caption>Activity during this date range and current board content</caption><thead><tr>
                {% for label in ['Board','Visits','Topic views','New topics','Replies','Poll votes','Favorites added','Engagements','Current topics','Current posts',''] %}<th scope="col">{{ label }}</th>{% endfor %}
            </tr></thead><tbody>
            {% for row in model.board_rows %}<tr><th scope="row"><a href="{{ url(row.url) }}">{{ row.name }}</a></th>
                {% for key in ['visits','topic_views','topics_created','replies_created','poll_votes','favorites_added','engagements','topiccount','postcount'] %}<td>{{ row[key]|number_format }}</td>{% endfor %}
                <td><a href="{{ row.public_url }}" aria-label="Open {{ row.name }}">Open board</a></td>
            </tr>{% endfor %}
            </tbody></table></div>{% else %}<p class="stats-empty">No boards are available.</p>{% endif %}
        </details>
    </div>
    {% endif %}
</div>
