<div class="corebb-post-toolbar" role="toolbar" aria-label="Formatting">
    <input class="markupButton" data-forum-action="fnMarkupBold" value="B" style="font-weight: bold;" title="Bold/Strong Text" type="button">
    <input class="markupButton" name="button2" type="button" style="font-style: italic;" title="Italic Text" data-forum-action="fnMarkupItalic" value="I">
    <input class="markupButton" name="button3" type="button" style="text-decoration: underline;" title="Underline Text" data-forum-action="fnMarkupUnderline" value="U">
    <input class="markupButton" name="button" type="button" style="text-decoration: Overline;" title="Overline Text" data-forum-action="fnMarkupOverline" value="O">
    <input class="markupButton" name="button4" type="button" style="text-decoration: underline; color: #0000FF;" title="Add Link" data-forum-action="fnMarkupLink" value="Link">
    <input class="markupButton" data-forum-action="fnMarkupColorPrompt" value="Color" title="Text Color" type="button">
    <input class="markupButton" data-forum-action="fnMarkupHighlightPrompt" value="HL" title="Highlight Text" type="button">
    <input class="markupButton" data-forum-action="fnMarkupSizePrompt" value="Size" title="Text Size" type="button">
    <input class="markupButton" data-forum-action="fnMarkupCodePrompt" value="Code" title="Code Block" type="button">
    <input class="markupButton" data-forum-action="fnMarkupImage" value="Image" title="Add Image" type="button">
    <input class="markupButton" data-forum-action="fnMarkupListItem" value=" &bull; Bullet " title="Add Bullet" type="button">
    <input type="button" data-forum-action="faces" value="Emoticons" class="markupButton" title="Faces/Smilies" id="btnFaces" name="btnFaces">
    {% include 'partials/post_faces_menu.twig' with {faces: post_faces_model()} only %}
</div>
