<div id="divFacesMenu" class="BoardRowA" data-forum-action="close-faces" style="display:none; position:absolute; border:2px solid black; padding:2px; left: 397px; top: 408px;">
    {% for row in faces.rows|default([]) %}
        {% for face in row %}
            {% if not loop.first %}&nbsp;{% endif %}<a class="BoardRowALink" href="#divFacesMenu" data-forum-action="face" data-face="{{ face.name }}" title="{{ face.name }}"><img src="{{ asset('images/faces/' ~ face.file) }}" alt="{{ face.name }}"></a>
        {% endfor %}
        &nbsp;<br>
    {% endfor %}
    [<a href="#divFacesMenu" data-forum-action="close-faces" class="BoardRowALink">close</a>]
</div>
